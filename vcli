# COLOURS
# Non-interactive shells and minimal containers may lack TERM/tput.
TAB="" RED="" GREEN="" YELLOW="" CYAN="" NONE="" BOLD=""
if [[ -t 1 && -n ${TERM:-} && $TERM != dumb ]] && command -v tput >/dev/null 2>&1; then
    TAB=$(tput setaf 4; tput bold)
    RED=$(tput setaf 1; tput bold)
    GREEN=$(tput setaf 2; tput bold)
    YELLOW=$(tput setaf 3)
    CYAN=$(tput setaf 6; tput bold)
    NONE=$(tput sgr0)
    BOLD=$(tput bold)
fi

# Rendering is optional on simple TTYs. Never require terminfo/tput to
# accept commands: basic linear input must work with TERM=dumb or unset.
# Cursor repaint may be limited on such terminals.
function vcli_tput(){
    [[ -t 1 && -n ${TERM:-} && $TERM != dumb ]] || return 0
    command -v tput >/dev/null 2>&1 || return 0
    tput "$@" 2>/dev/null || true
}

# URI encoder
function urlencode {
    jq -nr --arg v "$1" '$v|@uri'
}

# Check dependencies
function check_dependency(){
    local dependencies
    dependencies=$*
    for dependency in $dependencies; do
        if ! command -v "$dependency" >/dev/null; then
            echo "$SCRIPTNAME: command '$dependency' not found"
            exit 1
        fi
    done
}

function check_connectivity(){
    # Reuse the real Vault transport: TLS verification, optional mTLS, and
    # curl connect/overall deadlines. HTTP 4xx/5xx still means reachable.
    # -i discards body/status while -_disable_-f_- accepts all HTTP codes;
    # transport and certificate failures must always abort startup.
    if ! _curl -i -_disable_-f_- "/sys/health" "" GET >/dev/null; then
        echo "Cannot establish connection to $protocol://$vault_host:$vault_port" >&2
        return 1
    fi
}

# check vcli latest version
function new_version(){
    # The original upstream release check is obsolete and adds network traffic.
    # Keep this function as a compatibility stub; a modern release process can
    # restore update checks later.
    return 1
}

# Print prompt
function prompt(){
    if [[ $disable_prompt ]]; then
        return
    fi
    local COLOUR=$CYAN
    debug "prompt: http_code=$http_code"
    if [[ $http_code =~ ^2 ]]; then
        COLOUR=$GREEN
    elif [[ $http_code =~ ^3 ]]; then
        COLOUR=$YELLOW
    elif [[ $http_code =~ ^4 ]] || [[ $http_code =~ ^5 ]]; then
        COLOUR=$RED
    fi
    echo -n "[$COLOUR$http_code$NONE] $BOLD$SCRIPTNAME$TAB@$NONE$BOLD$vault_host$TAB:$NONE$BOLD$vault_port$current_pwd$TAB >$NONE "
}

# Open once and pin a verified private inode; later pathname swaps are inert.
# Use native BSD stat for secure inode metadata on Darwin, GNU on Linux.
function vcli_stat_identity(){
    if [[ $OSTYPE == darwin* ]]; then
        /usr/bin/stat -L -f '%i:%u:%OLp:%l' "$1"
    else
        stat -L -c '%i:%u:%a:%h' "$1"
    fi
}

# Files are published at an exact pathname, never inside a raced-in directory.
# On Darwin use the OS link(2)/rename(2) syscalls via system Perl; BSD
# ln/mv lack GNU -T. A missing native helper fails closed, not via unsafe ln.
function vcli_link_exclusive(){
    if [[ $OSTYPE == darwin* ]]; then
        [[ -x /usr/bin/perl ]] || {
            echo 'vcli: secure file publication requires system Perl on macOS' >&2
            return 1
        }
        /usr/bin/perl -e '
            @ARGV == 2 or die "vcli: expected source and destination\n";
            link($ARGV[0], $ARGV[1])
                or die "vcli: exclusive file publication failed: $!\n";
        ' -- "$1" "$2"
    else
        ln -T -- "$1" "$2"
    fi
}

function vcli_replace_exact(){
    if [[ $OSTYPE == darwin* ]]; then
        [[ -x /usr/bin/perl ]] || {
            echo 'vcli: secure history replacement requires system Perl on macOS' >&2
            return 1
        }
        /usr/bin/perl -e '
            @ARGV == 2 or die "vcli: expected source and destination\n";
            rename($ARGV[0], $ARGV[1])
                or die "vcli: atomic history replacement failed: $!\n";
        ' -- "$1" "$2"
    else
        mv -T -f -- "$1" "$2"
    fi
}

function vcli_debug_open(){
    [[ -z ${VCLI_DEBUG_FD:-} ]] || return 0
    local staged="" fd="" path_identity="" fd_identity=""
    if [[ -L $DEBUGFILE || ( -e $DEBUGFILE && ! -f $DEBUGFILE ) ]]; then
        echo "vcli: refusing unsafe debug path" >&2
        return 1
    fi
    if [[ ! -e $DEBUGFILE ]]; then
        staged=$(mktemp -- "${DEBUGFILE}.XXXXXXXX") || return 1
        if ! vcli_link_exclusive "$staged" "$DEBUGFILE"; then
            rm -f -- "$staged"
            echo "vcli: debug path occupied during creation" >&2
            return 1
        fi
        rm -f -- "$staged" || return 1
    fi
    if ! { exec {fd}>> "$DEBUGFILE"; }; then return 1; fi
    # macOS /dev/fd can report a synthetic device; -ef may fail even when
    # the inode matches. Keep -ef on Linux, compare inode metadata on macOS.
    path_identity=$(vcli_stat_identity "$DEBUGFILE" 2>/dev/null) || path_identity=""
    fd_identity=$(vcli_stat_identity "/dev/fd/$fd" 2>/dev/null) || fd_identity=""
    if [[ -L $DEBUGFILE || ! -f /dev/fd/$fd || ! -O /dev/fd/$fd ||
          -z $fd_identity || $path_identity != "$fd_identity" ||
          $fd_identity != *:600:1 ]] ||
       { [[ $OSTYPE != darwin* ]] && [[ ! $DEBUGFILE -ef /dev/fd/$fd ]]; }; then
        exec {fd}>&-
        echo "vcli: refusing insecure debug file (owned 0600, one link required)" >&2
        return 1
    fi
    VCLI_DEBUG_FD=$fd
}

function vcli_debug_close(){
    [[ -n ${VCLI_DEBUG_FD:-} ]] || return 0
    local fd=$VCLI_DEBUG_FD
    VCLI_DEBUG_FD=""
    exec {fd}>&-
}

function debug(){
    [[ ${DEBUG:-no} == yes ]] || return 0
    vcli_debug_open || { DEBUG=no; return 1; }
    printf '%s\n' "$*" >&"$VCLI_DEBUG_FD"
}

