# Parse OpenSSL GMT notAfter dates with GNU date or native macOS BSD date.
function vcli_cert_expiry_epoch(){
    local raw="${1:-}" value
    [[ $raw == notAfter=* ]] || return 1
    value=${raw#notAfter=}
    [[ $value =~ ^[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[0-9]{4}[[:space:]]+GMT$ ]] || return 1
    if [[ $OSTYPE == darwin* ]]; then
        # Exercise the native BSD implementation even when GNU date is on PATH.
        LC_ALL=C /bin/date -u -j -f '%b %e %T %Y GMT' "$value" +%s
    else
        LC_ALL=C date -u -d "$value" +%s
    fi
}

# returns expiration date for specified certificates secret
# Keep expiry options identical while sharing the fetched snapshot.
function vcli_cert_expiration_from_data(){
    local path="$1" option="$2" data="$3" stem crt end days now expiration
    _vcli_cert_pairs "$data" || return 1
    local -a stems
    mapfile -t stems < <(jq -r 'keys[] | select(endswith("_crt")) | .[:-4]' <<< "$data")
    now=$(date +%s)
    for stem in "${stems[@]}"; do
        crt=$(jq -er --arg k "${stem}_crt" '.[$k]' <<< "$data") || return 1
        end=$(printf '%s\n' "$crt" | openssl x509 -noout -enddate 2>/dev/null) || return 1
        expiration=$(vcli_cert_expiry_epoch "$end") || return 1
        days=$(( (expiration-now)/86400 ))
        # Compare seconds so just-expired certificates are never classified OK.
        local remaining=$((expiration-now)) status
        if (( remaining <= 0 )); then status=EXPIRED
        elif (( remaining <= cert_critical_threshold*86400 )); then status=CRITICAL
        elif (( remaining <= cert_warning_threshold*86400 )); then status=WARNING
        else status=OK
        fi
        [[ $option == -oo && $status == OK ]] && continue
        [[ $option == -ow && $status == WARNING ]] && continue
        [[ $option == -oc && ( $status == CRITICAL || $status == EXPIRED ) ]] && continue
        local tone=""
        case $status in
            OK) tone=$GREEN ;;
            WARNING) tone=$YELLOW ;;
            CRITICAL|EXPIRED) tone=$RED ;;
        esac
        printf '%s (%s): %d days to renew certificate [%s%s%s]\n' "$stem" "$path" "$days" "$tone" "$status" "$NONE"
    done
}
function _getcertexpiration(){
    local path="" option="" arg data
    for arg in "$@"; do
        case "$arg" in -oo|-ow|-oc) option="$arg";; -*) return 1;; "") ;; *) path="$arg";; esac
    done
    [[ -n $path ]] || return 1
    data=$(_vcli_pki_json "$path") || return 1
    vcli_cert_expiration_from_data "$path" "$option" "$data"
}

# recovers krb.list with all keytabs found under the specified folder
# One read per leaf; only Kerberos-shaped secrets proceed to validation.
function _getallkrblist(){
    local root leaves path data
    root=$(_vcli_absolute_path "${1:-}") || return 1
    leaves=$(_vcli_leaves "$root") || return 1
    while IFS= read -r path; do
        [[ -n $path ]] || continue
        data=$(_vcli_pki_json "$path") || return 1
        jq -e 'any(keys[]; endswith("_principal"))' <<< "$data" >/dev/null || continue
        vcli_krb_list_from_data "$path" "$data" || return 1
    done <<< "$leaves"
}

