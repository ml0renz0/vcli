# Usage
function help(){
    cat <<EOH
Usage: $SCRIPTNAME -v <vault_host> -p <vault_port> -t <vault_token> [-i] [-n]
            -i: use insecure http
            -n: do not print prompt or commands. Useful when input is piped from stdin
       $SCRIPTNAME --version
EOH
}

# Print commands help; sort keys once and keep IFS scoped to callers.
function commands_help(){
    local arg="$1" command
    local -a sorted_commands
    if [[ -n $arg && ${vcli_commands[$arg]+present} ]]; then
        echo -e "${vcli_commands_help[$arg]}"
        return 0
    fi
    mapfile -t sorted_commands < <(printf '%s\n' "${!vcli_commands[@]}" | LC_ALL=C sort)
    if [[ ! $arg ]]; then
        echo -e "Available commands:\n"
        for command in "${sorted_commands[@]}"; do
            echo -e "$command: ${vcli_commands_help[$command]}\n"
        done
        return
    fi
    echo -e "unkown '$arg' vcli command. Available commands:"
    for command in "${sorted_commands[@]}"; do
        echo "   $command"
    done
    return 1
}

# Check for given arguments
function check_arg(){
    local arg=$1
    local msg=$2
    if [[ ! $arg ]]; then
        echo -e "ERROR! No $msg provided\n"
        help ; exit 1
    fi
}

# save & clean & exit
function clean_n_exit(){
    save_history
    [[ ! $disable_prompt ]] && echo
    ## REMOVED: it seems this bug doesn't reproduce anymore ##
    #
    # reset terminal when running inside a container as local echo gets disabled (??)
    # if ! head -n 1 /proc/1/sched | grep -qE "(systemd|init)"; then
    #   reset
    # fi
    if [[ -n $http_code && ! $http_code =~ ^2 ]]; then exit_status=1 ; fi
    exit $exit_status
}

# Run command and prettyfy stdout
# _run used eval on interpolated HTTP commands; replaced by safe curl arrays.
function _run(){
    echo "Internal error: legacy _run is no longer supported" >&2
    return 1
}

# Map legacy paths to KV v2 HTTP paths when opted in.
# VAULT_KV_VERSION=2 VAULT_KV_MOUNTS=secret,teams/config
# Resolve the longest configured KV v2 mount; nested mounts take precedence.
# Writes the match to VCLI_KV_MOUNT in the calling shell, avoiding subshell state.
function vcli_match_kv2_mount(){
    VCLI_KV_MOUNT=""
    [[ ${VAULT_KV_VERSION:-1} == 2 ]] || return 1
    local path="${1#/}" mount
    local -a mounts
    IFS=',' read -r -a mounts <<< "${VAULT_KV_MOUNTS:-secret}"
    for mount in "${mounts[@]}"; do
        mount="${mount#/}"; mount="${mount%/}"
        [[ -n $mount && $path == "$mount/"* ]] || continue
        if (( ${#mount} > ${#VCLI_KV_MOUNT} )); then
            VCLI_KV_MOUNT=$mount
        fi
    done
    [[ -n $VCLI_KV_MOUNT ]]
}

function vcli_is_kv2_path(){
    vcli_match_kv2_mount "$1"
}

function vcli_kv2_metadata_path(){
    local mount rest
    vcli_match_kv2_mount "$1" || return 1
    mount=$VCLI_KV_MOUNT
    rest="${1#/}"
    rest="${rest#"$mount/"}"
    printf '/%s/metadata/%s\n' "$mount" "$rest"
}

function vcli_kv_path(){
    local path="${1#/}" method="$2" mount rest
    vcli_match_kv2_mount "$path" || { printf '%s' "$path"; return; }
    mount=$VCLI_KV_MOUNT
    rest="${path#"$mount/"}"
    case "$rest" in
        data/*|metadata/*|delete/*) printf '%s' "$path"; return;;
    esac
    case "$method" in
        LIST) printf '%s/metadata/%s' "$mount" "$rest" ;;
        GET|POST|PUT|PATCH|DELETE) printf '%s/data/%s' "$mount" "$rest" ;;
        *) printf '%s' "$path";;
    esac
}

# Encode path components but do not encode / or the query delimiter ?.
function vcli_encode_endpoint(){
    local raw="${1#/}" path query encoded
    path="${raw%%\?*}"
    # A single jq call encodes each segment independently while preserving /
    # separators, empty segments and a caller-supplied Vault query string.
    encoded=$(jq -nr --arg p "$path" '$p | split("/") | map(@uri) | join("/")') || return 1
    if [[ $raw == *\?* ]]; then
        query="${raw#*\?}"
        encoded+="?$query"
    fi
    printf '%s' "$encoded"
}

# Report partial application without pretending multi-request Vault changes are atomic.
function _vcli_partial_failure(){
    local operation="$1" completed="$2" total="$3" current="$4"
    if (( completed > 0 )); then
        printf 'vcli: PARTIAL %s completed=%d total=%d failed=%s; no rollback performed\n' \
            "$operation" "$completed" "$total" "$current" >&2
    else
        printf 'vcli: FAILED %s completed=0 total=%d failed=%s\n' \
            "$operation" "$total" "$current" >&2
    fi
    return 1
}

# Common read-only recursion for KV mounts; failures propagate to callers.
# Resolve Vault paths without subshells; the named result belongs to the caller.
function _vcli_resolve_path(){
    local -n _vcli_out="$1"
    local _vcli_value="${2:-}"
    [[ -n $_vcli_value ]] || return 1
    [[ $_vcli_value == /* ]] || _vcli_value="${current_pwd%/}/$_vcli_value"
    _vcli_value="/${_vcli_value#/}"
    while [[ $_vcli_value == *'//'* ]]; do
        _vcli_value="${_vcli_value//\/\//\/}"
    done
    if [[ $_vcli_value == *'/../'* || $_vcli_value == *'/./'* ||
          $_vcli_value == */.. || $_vcli_value == */. ]]; then
        return 1
    fi
    [[ $_vcli_value == / ]] || _vcli_value="${_vcli_value%/}"
    _vcli_out="$_vcli_value"
}

function _vcli_absolute_path(){
    local normalized
    _vcli_resolve_path normalized "${1:-}" || return 1
    printf '%s\n' "$normalized"
}
function _vcli_children(){
    local response
    response=$(_curl "${1%/}/" "" LIST) || return 1
    # Validate and emit in one jq process; an empty array is a valid listing.
    jq -r 'if (.data.keys | type) == "array" then .data.keys[] else error("invalid Vault LIST response") end' <<< "$response"
}
function _vcli_leaves(){
    local root="$1" entries child
    entries=$(_vcli_children "$root") || return 1
    while IFS= read -r child; do
        [[ -n $child ]] || continue
        if [[ $child == */ ]]; then
            _vcli_leaves "${root%/}/${child%/}" || return 1
        else
            printf '%s\n' "${root%/}/$child"
        fi
    done <<< "$entries"
}

# Curl transport configuration shared by AppRole and token requests.
# The caller owns the argument array; authentication remains separate.
function vcli_curl_transport_args(){
    local -n _vcli_transport_out="$1"
    _vcli_transport_out=(--silent --show-error
        --connect-timeout "${VCLI_CONNECT_TIMEOUT:-2}"
        --max-time "${VCLI_HTTP_TIMEOUT:-30}")
    case "${VAULT_SKIP_VERIFY:-false}" in
        1|true|TRUE|yes|YES) _vcli_transport_out+=(--insecure);;
    esac
    [[ -n ${VAULT_CACERT:-} ]] && _vcli_transport_out+=(--cacert "$VAULT_CACERT")
    [[ -n ${VAULT_CAPATH:-} ]] && _vcli_transport_out+=(--capath "$VAULT_CAPATH")
    if [[ -n ${VAULT_CLIENT_CERT:-} || -n ${VAULT_CLIENT_KEY:-} ]]; then
        if [[ -z ${VAULT_CLIENT_CERT:-} || -z ${VAULT_CLIENT_KEY:-} ]]; then
            echo "vcli: both VAULT_CLIENT_CERT and VAULT_CLIENT_KEY are required" >&2
            return 1
        fi
        _vcli_transport_out+=(--cert "$VAULT_CLIENT_CERT" --key "$VAULT_CLIENT_KEY")
    fi
    [[ -n ${VAULT_NAMESPACE:-} ]] &&
        _vcli_transport_out+=(--header "X-Vault-Namespace: $VAULT_NAMESPACE")
    return 0
}
# AppRole login uses the same TLS verification as ordinary Vault calls.
# Never print role_id, secret_id or the resulting client token.
function _vcli_login_approle(){
    local role_id="${VAULT_ROLE_ID:-}" secret_id="${VAULT_SECRET_ID:-}" response_file payload_file code status
    [[ -n $role_id && -n $secret_id ]] || {
        echo "vcli: incomplete AppRole credentials" >&2; return 1;
    }
    # Validate the complete TLS configuration before staging credentials.
    local -a args=()
    vcli_curl_transport_args args || return 1
    response_file=$(mktemp "${VCLI_SESSION_TMP:-$TMP}/.vcli.auth.XXXXXX") || return 1
    payload_file=$(mktemp "${VCLI_SESSION_TMP:-$TMP}/.vcli.auth-data.XXXXXX") || {
        rm -f "$response_file"; return 1;
    }
    # Never pass the secret_id through process argv.
    local login_result=0
    if ! jq -cn --rawfile rid <(printf '%s' "$role_id") \
           --rawfile sid <(printf '%s' "$secret_id") \
           '{role_id:$rid,secret_id:$sid}' > "$payload_file"; then
        login_result=1
    else
        args+=(--request POST --header "Content-Type: application/json"
            --data-binary "@$payload_file"
            --output "$response_file" --write-out '%{http_code}')
        status=$(curl "${args[@]}" "$protocol://$vault_host:$vault_port/v1/auth/approle/login")
        code=$?
        if (( code != 0 )) || [[ $status != 2* ]]; then
            echo "vcli: AppRole login failed" >&2
            login_result=1
        elif ! vault_token=$(jq -er '.auth.client_token | select(type=="string" and length>0)' "$response_file"); then
            echo "vcli: invalid AppRole response" >&2
            login_result=1
        fi
    fi
    # AppRole owns both files, regardless of transport or parsing outcome.
    rm -f -- "$response_file" "$payload_file"
    return "$login_result"
}
function _renew_token(){
    local increment="${1:-}" payload response
    if [[ -n $increment && ! $increment =~ ^[0-9]+(s|m|h)?$ ]]; then
        echo "vcli: invalid renewal increment" >&2; return 1;
    fi
    payload=$(mktemp "${VCLI_SESSION_TMP:-$TMP}/.vcli.renew.XXXXXX") || return 1
    if [[ -n $increment ]]; then
        if ! jq -cn --arg value "$increment" '{increment:$value}' > "$payload"; then
            rm -f -- "$payload"
            return 1
        fi
    elif ! printf '{}\n' > "$payload"; then
        rm -f -- "$payload"
        return 1
    fi
    local request_status=0
    response=$(_curl "/auth/token/renew-self" "$payload" POST) || request_status=$?
    rm -f -- "$payload"
    if (( request_status != 0 )); then
        echo "vcli: token renewal failed" >&2
        return 1
    fi
    jq -e '.auth.renewable == true' <<< "$response" >/dev/null || {
        echo "vcli: token is not renewable" >&2; return 1;
    }
    echo "Vault token renewed"
}

# Render and validate HTTP JSON; caller owns response temporary file.
function vcli_emit_http_response(){
    local file="$1" status="$2" method="$3" data="$4" kv2="$5" cas="$6"
    if [[ $status == 2* && ( $method == GET || $method == LIST ) ]]; then
        # Parse once: a Vault read must contain exactly one JSON object.
        # Slurp validates the entire body before emitting anything, avoiding
        # partial output or a second jq process after type verification.
        local filter='if length == 1 and (.[0] | type) == "object" then .[0] else error("invalid Vault JSON") end'
        local -a jq_flags=(-s)
        if [[ $data == '-_list_root_-' ]]; then
            filter+=' | .data | keys[]'
            jq_flags+=(-r)
        elif [[ $kv2 == yes && $method == GET && $cas != raw ]]; then
            filter+=' | if (.data.data | type) == "object" then .data = .data.data else . end'
        fi
        if ! jq "${jq_flags[@]}" "$filter" "$file" 2>/dev/null; then
            echo "vcli: invalid or empty JSON from Vault" >&2
            return 1
        fi
    elif [[ $data == '-_list_root_-' ]]; then
        jq -r '.data | keys[]' "$file"
    elif [[ -s $file ]]; then
        jq '.' "$file"
    fi
}

# simplified curl function
function _curl(){
    local ignore_http_code=no disable_fail=no
    while :; do
        case "${1:-}" in
            -i) ignore_http_code=yes; shift;;
            -_disable_-f_-) disable_fail=yes; shift;;
            '') shift; break;;
            *) break;;
        esac
    done
    local path="${1#/}" data="${2:-}" method="${3:-GET}" cas="${4:-}"
    local kv2=no mount rest
    if vcli_match_kv2_mount "$path"; then
        mount=$VCLI_KV_MOUNT
        rest="${path#"$mount/"}"
        # Already-explicit Vault API paths must not be wrapped a second time.
        if [[ $rest != data/* && $rest != metadata/* && $rest != delete/* ]]; then
            case "$method" in GET|POST|PUT|PATCH|DELETE|LIST)
                kv2=yes
                path=$(vcli_kv_path "$path" "$method")
                ;;
            esac
        fi
    fi

    local encoded url response_file payload_file="" payload="" status curl_status
    encoded=$(vcli_encode_endpoint "$path") || return 1
    url="$protocol://$vault_host:$vault_port/v1/$encoded"
    local -a args=()
    vcli_curl_transport_args args || return 1
    response_file=$(mktemp "${VCLI_SESSION_TMP:-$TMP}/.vcli.response.XXXXXX") || return 1
    args+=(--request "$method" --output "$response_file"
        --write-out '%{http_code}' --header @-
        --header 'Content-Type: application/json')
    if [[ -n $data && $data != '-_list_root_-' ]]; then
        if [[ ! -f $data ]]; then
            echo "vcli: request payload file missing: $data" >&2
            rm -f "$response_file"
            return 1
        fi
        payload="$data"
        if [[ $kv2 == yes && ( $method == POST || $method == PUT || $method == PATCH ) ]]; then
            payload_file=$(mktemp "${VCLI_SESSION_TMP:-$TMP}/.vcli.payload.XXXXXX") || {
                rm -f -- "$response_file"
                return 1
            }
            if [[ -n $cas ]]; then
                if ! jq -c --argjson cas "$cas" '{data: ., options: {cas: $cas}}' "$data" > "$payload_file"; then
                    rm -f "$response_file" "$payload_file"
                    return 1
                fi
            elif ! jq -c '{data: .}' "$data" > "$payload_file"; then
                rm -f "$response_file" "$payload_file"
                return 1
            fi
            payload="$payload_file"
        fi
        args+=(--data-binary "@$payload")
    fi
    debug "request: $method $url"
    # Supply the Vault token over stdin, not as a process-list argument.
    # --header @- is supported by modern curl versions.
    local started_at=$SECONDS
    status=$(printf 'X-Vault-Token: %s\n' "$vault_token" | curl "${args[@]}" "$url")
    curl_status=$?
    if [[ $VERBOSE == yes ]]; then
        # Do not echo Vault tokens, paths, payloads or response bodies.
        printf 'vcli: HTTP %s -> %s (%ds)\n' "$method" "${status:-000}" "$((SECONDS-started_at))" >&2
    fi
    # Only the KV2 wrapper belongs to the transport; caller owns $data.
    [[ -n $payload_file ]] && rm -f -- "$payload_file"
    local render_status=0
    if (( curl_status != 0 )); then
        http_code="000"
        # A write may have committed before its HTTP response was lost.
        # Never blindly retry non-idempotent operations on transport errors.
        if [[ $method == POST || $method == PUT || $method == PATCH || $method == DELETE ]]; then
            printf 'vcli: OUTCOME_UNKNOWN method=%s path=/%s; verify Vault state before retrying\n' "$method" "$path" >&2
        fi
        [[ $ignore_http_code == no ]] && cat "$response_file" >&2
        render_status=1
    elif [[ $ignore_http_code == no ]]; then
        http_code="$status"
        vcli_emit_http_response "$response_file" "$status" "$method" "$data" "$kv2" "$cas" || render_status=1
    fi
    # Shared response cleanup after transport, HTTP and JSON outcomes.
    rm -f "$response_file"
    (( render_status == 0 )) || return 1
    [[ $status == 2* || $disable_fail == yes ]]
}

# run command entered in CLI
function run_cmd(){
    local args
    local fullcmd="$*"
    args=${*#* }
    if [[ $fullcmd == "$args" ]]; then
        unset args
    fi
    backIFS=$IFS
    while IFS=$' ' read -r cmd arg1 arg2 arg3; do
        if [[ $arg1 == "!$" ]]; then
            arg1=$(get_lastcmd_arg) || { echo "vcli: !$ requires a previous command with arguments" >&2; return 1; }
        fi
        if ! is_cmd "$fullcmd"; then
            commands_help "$cmd"
            return 1
        fi
        # Record even when a read fails. add_cmd excludes sensitive write payloads.
        add_cmd "$cmd $arg1 $arg2 $arg3" || true
        local command_status=0
        case $cmd in
            cd)                     _cd "$arg1" ;;
            ls)                     _ls "$arg1" ;;
            lsrole)                 _lsrole ;;
            showrole)               _showrole "$arg1" ;;
            renew-token)            _renew_token "$arg1" ;;
            lspol)                  _lspol ;;
            showpol)                _showpol "$arg1" ;;
            tree)                   backIFS=$IFS; IFS=$' ' ; _tree "$arg1"  || { IFS=$backIFS; return 1; }; IFS=$backIFS;;
            find)                   backIFS=$IFS; IFS=$' ' ; _find "$arg1" "$arg2 $arg3"  || { IFS=$backIFS; return 1; }; IFS=$backIFS;;
            replace)                backIFS=$IFS; IFS=$' ' ; _replace "$arg1" "$arg2 $arg3"  || { IFS=$backIFS; return 1; }; IFS=$backIFS;;
            cptree)                 backIFS=$IFS; IFS=$' ' ; _cptree "$arg1" "$arg2"  || { IFS=$backIFS; return 1; }; IFS=$backIFS;;
            rmtree)                 backIFS=$IFS; IFS=$' ' ; _rmtree "$arg1" "$arg2" || { IFS=$backIFS; return 1; }; IFS=$backIFS;;
            backup)                 backIFS=$IFS; IFS=$' ' ; _backup "$arg1"  || { IFS=$backIFS; return 1; }; IFS=$backIFS;;
            restore)                backIFS=$IFS; IFS=$' ' ; _restore "$arg1"  || { IFS=$backIFS; return 1; }; IFS=$backIFS;;
            cat)                    _cat "$arg1" ;;
            put)                    _put "$arg1" "$arg2 $arg3" ;;
            addsecret)              _addsecret "$arg1" "$arg2 $arg3" ;;
            delsecret)              _delsecret "$arg1" "$arg2" ;;
            rm)
                # Preserve the true argument count; do not pass absent fields
                # as empty positional arguments to the guarded purge parser.
                if [[ -z $arg2 ]]; then
                    _rm "$arg1"
                elif [[ -z $arg3 ]]; then
                    _rm "$arg1" "$arg2"
                else
                    _rm "$arg1" "$arg2" "$arg3"
                fi
            ;;
            cp)                     _cp "$arg1" "$arg2" ;;
            getcert)                _getcert "$arg1" ;;
            getsan)                 _getsan "$arg1" ;;
            getprinc)               _getprinc "$arg1" ;;
            getcertlist)            _getcertlist "$arg1" ;;
            getkrblist)             _getkrblist "$arg1" ;;
            getcertexpiration)      _getcertexpiration "$arg1" "$arg2" "$arg3" ;;
            getallcertlist)         _getallcertlist "$arg1" ;;
            getallkrblist)          _getallkrblist "$arg1" ;;
            getallcertexpiration)   _getallcertexpiration "$arg1" "$arg2" ;;
            certinfo)               _certinfo "$arg1" ;;
            getkrb)                 _getkrb "$arg1" ;;
            krbinfo)                _krbinfo "$arg1" ;;
            mv)                     _mv "$arg1" "$arg2" ;;
            mount)                  _mount "$args" ;;
            umount)                 _umount "$args" ;;
            history)                print_history ;;
            exit)                   save_history; exit ;;
            help)                   commands_help "$arg1" ;;
            enable-debug)           vcli_debug_open || return 1; echo "debug enabled" ; DEBUG="yes";;
            disable-debug)          echo "debug disabled" ; DEBUG="no"; vcli_debug_close;;
            verbose)                if [[ $VERBOSE == "yes" ]]; then
                                        echo "verbose mode OFF"
                                        VERBOSE="no"
                                    else
                                        echo "verbose mode ON"
                                        VERBOSE="yes"
                                    fi ;;
            enable-hexdump-debug)   echo "hexdump debug enabled" ; DEBUG_HEXDUMP="yes";;
            disable-hexdump-debug)  echo "hexdump debug disabled" ; DEBUG_HEXDUMP="no";;
            \#*)                    return;; # ignore commented lines
            *)                      commands_help "$cmd" ; return 1 ;;
        esac
        command_status=$?
        debug "run_cmd: $cmd"
        debug "run_cmd: http_code=$http_code"
        if (( command_status != 0 )); then return "$command_status"; fi
    done< <(echo "$fullcmd")
}

# mount function
function _mount(){
    if [[ "$1" == "-i" ]]; then
        local ignore_http_code="true"
        shift
    fi
    local url="$*"
    local data
    if [[ ! $url ]]; then
        local details mounted name backend list_status
        details=$(_curl /sys/mounts "" GET) || return 1
        mounted=$(jq -r '.data | to_entries | sort_by(.key)[] | [.key,.value.type] | @tsv' <<< "$details") || return 1
        echo "mounted paths (first-level content only):"
        while IFS=$'\t' read -r name backend; do
            [[ -n $name ]] || continue
            list_status="not a KV secret mount"
            if [[ $backend == kv || $backend == cubbyhole ]]; then
                if _curl "/${name}" "" LIST >/dev/null 2>&1; then
                    list_status="contains entries"
                else
                    case $http_code in
                        404) list_status="empty" ;;
                        403) list_status="not authorized to list" ;;
                        *) list_status="listing unavailable (HTTP ${http_code:-000})" ;;
                    esac
                fi
            fi
            printf '%-28s %-12s %s\n' "$name" "$backend" "$list_status"
        done <<< "$mounted"
    # mount $url
    else
        # get full path if relative reference
        if [[ ! "$url" =~ ^/ ]]; then
            url="/sys/mounts/$current_pwd$url"
        else
            url="/sys/mounts$url"
        fi
        data=$(mktemp -- "${VCLI_SESSION_TMP:-$TMP}/.put.XXXXXX") || return 1
        if ! jq -nc --arg d "$url secret backend" --arg v "${VAULT_KV_VERSION:-1}" '{type:"kv",description:$d,options:{version:$v}}' > "$data"; then
            rm -f -- "$data"
            return 1
        fi
        local request_status=0
        if [[ $ignore_http_code ]]; then
            _curl -i "$url" "$data" "POST" || request_status=$?
        else
            _curl "$url" "$data" "POST" || request_status=$?
        fi
        rm -f -- "$data"
        (( request_status == 0 )) || return "$request_status"
        [[ ${http_code:-} == 2* ]] || return 1
        echo "mounted '$url'"
    fi
}

# umount function
function _umount(){
    if [[ "$1" == "-i" ]]; then
        local ignore_http_code="true"
        shift
    fi
    local url="$*"
    if [[ ! $url ]]; then
        echo "umount needs an argument"
        _mount
    fi
    # get full path if relative reference
    if [[ ! "$url" =~ ^/ ]] && [[ ! "$url" =~ ^/sys/mounts ]]; then
        url="/sys/mounts/$current_pwd$url"
    elif [[ ! "$url" =~  ^/sys/mounts ]]; then
        url="/sys/mounts$url"
    fi
    if [[ $ignore_http_code ]]; then
        _curl -i "$url" "" "DELETE"
    else
        _curl "$url" "" "DELETE"
    fi
}

# cd function
function _cd(){
    local requested="${1:-}" target url entries
    if [[ $requested == ".." ]]; then
        # Parent never needs a new LIST request.
        target="${current_pwd%/}"
        target="${target%/*}"
        target="${target:-/}"
    elif [[ -z $requested || $requested == "." ]]; then
        target="${current_pwd:-/}"
    else
        target="$requested"
    fi
    if ! _vcli_resolve_path url "$target"; then
        echo "vcli: unsupported dot segment in cd path" >&2
        return 1
    fi
    [[ $url == / ]] || url+="/"
    if [[ $url != / && $requested != ".." && $requested != "." && -n $requested ]]; then
        entries=$(_ls "-_disable_colors_-" "$url") || {
            echo "vcli: cannot list directory '$url'" >&2
            return 1
        }
        if [[ -z $entries ]]; then
            echo "vcli: directory '$url' not found" >&2
            return 1
        fi
    fi
    if [[ $url == / ]]; then current_pwd=""; else current_pwd="$url"; fi
    debug "cd: current_pwd=$current_pwd"
    return 0
}

# ls function
function _ls(){
    local url tmp status=0 disable_colors="" ignore_http_code=""
    local -a request_flags=()
    if [[ ${1:-} == "-_disable_colors_-" ]]; then
        disable_colors=yes
        shift
    fi
    if [[ ${1:-} == "-i" ]]; then
        ignore_http_code="-i"
        shift
    fi
    if ! _vcli_resolve_path url "${1:-${current_pwd:-/}}"; then
        echo "vcli: invalid ls path" >&2
        return 1
    fi
    [[ $url == / ]] || url+="/"
    if [[ $url == "/" ]]; then
        if [[ $disable_colors ]]; then
            _cat /sys/mounts "-_list_root_-" | tr -d '"'
        else
            _cat /sys/mounts "-_list_root_-" | tr -d '"' | sed -e "s/\//$CYAN\/$NONE/"
        fi
        return
    fi
    [[ -n $ignore_http_code ]] && request_flags+=("$ignore_http_code")
    # One transport and one owned temporary, regardless of color mode.
    tmp=$(mktemp -- "${VCLI_SESSION_TMP:-$TMP}/ls.XXXXXX") || return 1
    if ! _curl "${request_flags[@]}" "$url" "" LIST > "$tmp"; then
        rm -f -- "$tmp"
        return 1
    fi
    if [[ $disable_colors ]]; then
        jq -r '.data.keys[]' "$tmp" || status=$?
    else
        jq -r '.data.keys[]' "$tmp" | sed -e "s/\//$CYAN\/$NONE/"
        local -a stages=("${PIPESTATUS[@]}")
        (( stages[0] == 0 && stages[1] == 0 )) || status=1
    fi
    rm -f -- "$tmp"
    return "$status"
}

# lsrole list roles
# Read one administrative endpoint. Transport failures get a useful stderr.
function vcli_admin_read_response(){
    local -n _vcli_admin_out="$1"
    local label="$2" endpoint="$3" method="${4:-GET}"
    _vcli_admin_out=$(_curl "$endpoint" "" "$method") || {
        printf 'vcli: failed to read %s\n' "$label" >&2
        return 1
    }
}

# A single validated JSON document is required before printing any list item.
# One strict JSON parser for administrative lists and details (one jq call).
function vcli_admin_extract(){
    local kind="$1" payload="$2"
    jq -sr --arg kind "$kind" '
        (if length == 1 and (.[0] | type) == "object"
         then .[0] else error("invalid administrative JSON") end) |
        if $kind == "role-list" or $kind == "policy-list" then
            (if $kind == "role-list" then .data.keys else .data.keys // .keys end) as $keys |
            if ($keys | type) == "array" and all($keys[]; type == "string")
            then $keys[] else error("invalid administrative list") end
        elif $kind == "role-detail" then
            (.data.token_policies // .data.policies // []) as $items |
            if (.data | type) == "object" and ($items | type) == "array"
               and all($items[]; type == "string")
            then $items[] else error("invalid AppRole policies") end
        elif $kind == "policy-detail" then
            (.data.policy // .policy) as $value |
            if ($value | type) == "string" and ($value | length) > 0
            then $value else error("invalid policy document") end
        else error("unknown administrative extraction")
        end
    ' <<< "$payload"
}

function _lsrole(){
    local response
    vcli_admin_read_response response "AppRole list" "/auth/approle/role?list=true" || return 1
    vcli_admin_extract role-list "$response" || {
        echo "vcli: invalid AppRole list response" >&2
        return 1
    }
}

# showpol list role policies
# Administrative names must stay one API path segment. _curl performs URI encoding.
function vcli_admin_name_valid(){
    local name="${1:-}"
    [[ -n $name && $name != . && $name != .. ]] || return 1
    case $name in
        */*|*\\*|*\?*|*'#'*|*[[:space:][:cntrl:]]*) return 1 ;;
    esac
    return 0
}

function _showrole(){
    local role="${1:-}" response policies
    [[ -n $role ]] || { echo "vcli: missing role" >&2; return 1; }
    vcli_admin_name_valid "$role" || { echo "vcli: invalid role name" >&2; return 1; }
    vcli_admin_read_response response "AppRole" "/auth/approle/role/$role" || return 1
    policies=$(vcli_admin_extract role-detail "$response") || {
        echo "vcli: invalid AppRole response" >&2
        return 1
    }
    printf 'policies: '
    [[ -z $policies ]] || printf '%s\n' "$policies"
}

# lspol list policies
function _lspol(){
    local response
    vcli_admin_read_response response "policy list" "/sys/policies/acl" LIST || return 1
    vcli_admin_extract policy-list "$response" || {
        echo "vcli: invalid policy list response" >&2
        return 1
    }
}

# showpol list policy rules
function _showpol(){
    local policy="${1:-}" response
    [[ -n $policy ]] || { echo "vcli: missing policy" >&2; return 1; }
    vcli_admin_name_valid "$policy" || { echo "vcli: invalid policy name" >&2; return 1; }
    vcli_admin_read_response response "policy" "/sys/policies/acl/$policy" || return 1
    vcli_admin_extract policy-detail "$response" || {
        echo "vcli: invalid policy response" >&2
        return 1
    }
}

function padecho(){
    local msg="$1"
    local depth="$2"
    local space="$3"
    local echospace="$4"
    # we print 2 spaces for every depth
    for (( i=${#space} ; i<$((depth*2)) ; i++ )) ; do
        # if is folder
        echo -n " "
    done
    msg=${msg/\/\//\/}
    msg=${msg//\//$CYAN\/$NONE}
    space=${space//+/$CYAN+$NONE}
    space=${space//\`/$CYAN\`$NONE}
    debug "${echospace}msg: $msg, depth: $depth ; space: \"$space\""
    echo "$space$msg"
}

# display the vault's secret tree
function _tree(){
    local url depth="${2:-0}" space="${3:-}" echo_space="${4:-}" paths path
    if ! _vcli_resolve_path url "${1:-${current_pwd:-/}}"; then
        echo "vcli: invalid tree path" >&2
        return 1
    fi
    [[ -n ${2:-} ]] && ((depth+=1))
    local node="${url##*/}"
    [[ $url == / ]] && node=""
    padecho "${node}/" "$depth" "$space" "$echo_space   "
    if [[ $url == / ]]; then
        # There is no LIST / endpoint. Root has mount points, like ls /.
        paths=$(_ls "-_disable_colors_-" "/") || return 1
        while IFS= read -r path; do
            [[ -n $path ]] && padecho "$path" "$((depth+1))" "$space\` " "$echo_space   "
        done <<< "$paths"
        return 0
    fi
    # A mount exists even when its first LIST returns 404 (empty KV).
    # A nested missing path or an ACL/transport failure must still fail.
    if [[ $url != */*/* ]]; then
        local roots data_file code
        roots=$(_ls "-_disable_colors_-" "/") || return 1
        if grep -Fxq -- "${url#/}/" <<< "$roots"; then
            data_file=$(mktemp "${VCLI_SESSION_TMP:-$TMP}/.vcli-tree.XXXXXX") || return 1
            if ! _curl "$url/" "" LIST > "$data_file"; then
                code=$http_code
                rm -f -- "$data_file"
                if [[ $code == 404 ]]; then
                    padecho "(empty)" "$((depth+1))" "$space\` " "$echo_space   "
                    return 0
                fi
                return 1
            fi
            paths=$(jq -r 'if (.data.keys | type) == "array" then .data.keys[] else error("invalid LIST") end' "$data_file") || { rm -f -- "$data_file"; return 1; }
            rm -f -- "$data_file"
        else
            paths=$(_vcli_children "$url") || return 1
        fi
    else
        paths=$(_vcli_children "$url") || return 1
    fi
    while IFS= read -r path; do
        [[ -n $path ]] || continue
        space=${space/+/ }
        if [[ $path == */ ]]; then
            _tree "$url/$path" "$depth" "$space+ " "$echo_space   " || return 1
        else
            padecho "$path" "$((depth+1))" "$space\` " "$echo_space   "
        fi
    done <<< "$paths"
}

# find secret in the vault's tree
function _find(){
    local root expected leaves leaf response actual
    root=$(_vcli_absolute_path "${1:-}") || {
        echo "Invalid find path" >&2; return 1;
    }
    # Compare canonical JSON objects, not whitespace-normalized shell text.
    expected=$(printf '%s\n' "${2:-}" | jq -ceS 'select(type == "object")') || return 1
    leaves=$(_vcli_leaves "$root") || return 1
    while IFS= read -r leaf; do
        [[ -n $leaf ]] || continue
        response=$(_cat "$leaf") || return 1
        actual=$(jq -ceS '.data | select(type == "object")' <<< "$response") || return 1
        if [[ $actual == "$expected" ]]; then
            padecho "$leaf" "0" "" ""
        fi
    done <<< "$leaves"
}

# find in $1 and replace secret $2 with new secret $3
function _replace(){
    local root pairs expected replacement leaves leaf response
    root=$(_vcli_absolute_path "$1") || { echo "Invalid replace path" >&2; return 1; }
    pairs=$(printf '%s\n' "$2" | jq -sc 'if length == 2 and all(.[]; type == "object") then . else error("expected two objects") end') || return 1
    expected=$(jq -c '.[0]' <<< "$pairs") || return 1
    replacement=$(jq -c '.[1]' <<< "$pairs") || return 1
    leaves=$(_vcli_leaves "$root") || return 1
    while IFS= read -r leaf; do
        [[ -n $leaf ]] || continue
        local version=""
        if vcli_is_kv2_path "$leaf"; then
            response=$(_curl "$leaf" "" GET raw) || return 1
            version=$(jq -er '.data.metadata.version' <<< "$response") || return 1
            response=$(jq -c '{data: .data.data}' <<< "$response") || return 1
        else
            response=$(_cat "$leaf") || return 1
        fi
        if jq -e --argjson expected "$expected" '.data == $expected' <<< "$response" >/dev/null; then
            _put "$leaf" "$replacement" "$version" || return 1
            printf '%s\n' "$leaf"
        fi
    done <<< "$leaves"
}

# copy secret tree to another location
function _cptree(){
    local source dest leaves leaf relative response payload target probe mount
    source=$(_vcli_absolute_path "$1") || { echo "Invalid source" >&2; return 1; }
    dest=$(_vcli_absolute_path "$2") || { echo "Invalid destination" >&2; return 1; }
    [[ $source != "$dest" && $dest != "$source/"* ]] || {
        echo "Destination must be outside source tree" >&2; return 1;
    }
    leaves=$(_vcli_leaves "$source") || return 1
    # Verify every target before any writes, including soft-deleted KV2 metadata.
    # Cache the longest-prefix mount classification to avoid duplicate lookups.
    local -a kv2_modes=()
    while IFS= read -r leaf; do
        [[ -n $leaf ]] || continue
        relative="${leaf#"$source"/}"
        target="$dest/$relative"
        if vcli_is_kv2_path "$target"; then
            mount=$VCLI_KV_MOUNT
            probe="/$mount/metadata/${target#"/$mount/"}"
            kv2_modes+=(yes)
        else
            probe="$target"
            kv2_modes+=(no)
        fi
        if _curl "$probe" >/dev/null; then
            echo "Destination already exists: $target" >&2
            return 1
        elif [[ $http_code != 404 ]]; then
            echo "Unable to verify destination: $target (HTTP $http_code)" >&2
            return 1
        fi
    done <<< "$leaves"
    local completed=0 total=${#kv2_modes[@]} idx=0
    while IFS= read -r leaf; do
        [[ -n $leaf ]] || continue
        relative="${leaf#"$source"/}"
        target="$dest/$relative"
        response=$(_cat "$leaf") || {
            _vcli_partial_failure cptree "$completed" "$total" "$leaf"; return 1;
        }
        payload=$(jq -ce '.data | select(type == "object")' <<< "$response") || {
            _vcli_partial_failure cptree "$completed" "$total" "$leaf"; return 1;
        }
        if [[ ${kv2_modes[idx]} == yes ]]; then
            _put "$target" "$payload" 0
        else
            _put "$target" "$payload"
        fi || {
            _vcli_partial_failure cptree "$completed" "$total" "$target"; return 1;
        }
        (( completed+=1, idx+=1 ))
    done <<< "$leaves"
    printf "Copied tree from '%s' to '%s'\n" "$source" "$dest"
}

# removes recursively a vault path
function _rmtree(){
    local forced=no root leaves leaf answer
    if [[ ${1:-} == -f ]]; then forced=yes; shift; fi
    root=$(_vcli_absolute_path "${1:-}") || { echo "Missing or invalid tree path" >&2; return 1; }
    case "$root" in
        /|/sys|/sys/*|/auth|/auth/*|/identity|/identity/*|/cubbyhole|/cubbyhole/*)
            echo "Refusing to delete a reserved Vault path" >&2; return 1;;
    esac
    [[ ${root#/} == */* ]] || { echo "Refusing to delete a whole mount" >&2; return 1; }
    leaves=$(_vcli_leaves "$root") || return 1
    if [[ $forced != yes ]]; then
        [[ -r /dev/tty ]] || { echo "Use rmtree -f for batch mode" >&2; return 1; }
        read -r -p "Remove secrets beneath '$root'? (yes/no): " answer </dev/tty || return 1
        [[ $answer == yes ]] || return 1
    fi
    local completed=0 total=0
    while IFS= read -r leaf; do [[ -n $leaf ]] && (( total+=1 )); done <<< "$leaves"
    while IFS= read -r leaf; do
        [[ -n $leaf ]] || continue
        _rm "$leaf" || {
            _vcli_partial_failure rmtree "$completed" "$total" "$leaf"; return 1;
        }
        (( completed+=1 ))
    done <<< "$leaves"
    printf "Removed secrets beneath '%s'\n" "$root"
}

# backup vault
function _backup(){
    local root leaves leaf response payload dir archive archive_stage relative parent
    root=$(_vcli_absolute_path "${1:-}") || { echo "Missing backup path" >&2; return 1; }
    [[ $root != / && ${root#/} == */* ]] || {
        echo "Backup requires a path within a secrets mount" >&2; return 1;
    }
    dir=$(mktemp -d "${VCLI_SESSION_TMP:-$TMP}/.vcli-backup.XXXXXX") || return 1
    if response=$(_cat "$root" 2>/dev/null); then
        leaves="$root"
    else
        leaves=$(_vcli_leaves "$root") || { rm -rf -- "$dir"; return 1; }
    fi
    while IFS= read -r leaf; do
        [[ -n $leaf ]] || continue
        response=$(_cat "$leaf") || { rm -rf -- "$dir"; return 1; }
        payload=$(jq -ce '.data | select(type == "object")' <<< "$response") || {
            rm -rf -- "$dir"; return 1;
        }
        relative="${leaf#/}"
        # Use native Bash path expansion and create parents only once.
        parent="${relative%/*}"
        if [[ ! -d "$dir/$parent" ]]; then
            mkdir -p -- "$dir/$parent" || { rm -rf -- "$dir"; return 1; }
        fi
        printf '%s\n' "$payload" > "$dir/$relative" || { rm -rf -- "$dir"; return 1; }
    done <<< "$leaves"
    # Build the whole archive in private staging. Never truncate a public
    # destination or follow a symlink placed there by another process.
    archive_stage=$(mktemp "${VCLI_SESSION_TMP:-$TMP}/.vcli-archive.XXXXXXXX") || {
        rm -rf -- "$dir"; return 1;
    }
    archive="${TMP%/}/backup_vault_${root//\//-}.$(date +%s).${archive_stage##*.}.tgz"
    if ! tar -czf "$archive_stage" -C "$dir" .; then
        rm -f -- "$archive_stage"
        rm -rf -- "$dir"
        return 1
    fi
    # Exclusive hardlink publication fails closed on collisions and symlinks.
    # Staging and output share TMP's filesystem; the published inode is 0600.
    if ! vcli_link_exclusive "$archive_stage" "$archive"; then
        rm -f -- "$archive_stage"
        rm -rf -- "$dir"
        echo "vcli: backup destination occupied or cannot be published" >&2
        return 1
    fi
    rm -f -- "$archive_stage"
    rm -rf -- "$dir"
    printf "Vault backup created: %s\n" "$archive"
}

# restore vault backup
function _restore(){
    local archive="${1:-}" cache rc
    [[ -f $archive && -r $archive ]] || { echo "Missing backup file" >&2; return 1; }
    cache=$(mktemp -d "${VCLI_SESSION_TMP:-$TMP}/.vcli-restore.XXXXXX") || return 1
    # The session also owns this private cache on signal/exit.
    if _vcli_restore_cached "$archive" "$cache"; then rc=0; else rc=$?; fi
    rm -rf -- "$cache" || return 1
    return "$rc"
}

function _vcli_restore_cached(){
    local archive="$1" cache="$2" listing entry relative payload types entry_type
    listing=$(tar -tzf "$archive") || return 1
    types=$(tar -tvzf "$archive") || return 1
    while IFS= read -r entry_type; do
        [[ -n $entry_type ]] || continue
        case "${entry_type:0:1}" in -|d) :;; *)
            echo "Unsupported archive member type" >&2; return 1;;
        esac
    done <<< "$types"
    # Validate every entry before writing anything; never use archive paths on disk.
    while IFS= read -r entry; do
        [[ -n $entry ]] || continue
        relative="${entry#./}"
        case "$relative" in
            ""|.|*/) continue ;;
            /*|..|../*|*/../*|*/..|./*|*/./*|*/.)
                echo "Unsafe archive path: $entry" >&2; return 1;;
        esac
        case "$relative" in
            sys/*|auth/*|identity/*|cubbyhole/*)
                echo "Refusing administrative path" >&2; return 1;;
        esac
        [[ $relative == */* && $relative != *'//'* ]] || {
            echo "Invalid archive path: $entry" >&2; return 1;
        }
    done <<< "$listing"
    # Full preflight before any write: reject duplicate paths and non-object JSON.
    local -A seen_entries=()
    local -a restore_paths=()
    local total=0 completed=0
    while IFS= read -r entry; do
        [[ -n $entry ]] || continue
        relative="${entry#./}"
        [[ -n $relative && $relative != . && $relative != */ ]] || continue
        if [[ -v seen_entries["$relative"] ]]; then
            echo "Duplicate archive member: $relative" >&2; return 1
        fi
        seen_entries["$relative"]=1
        # Numeric filenames only: archive member names never become local paths.
        # Spool once, validate before the first write, then reuse the same bytes.
        (umask 077; tar -xOzf "$archive" -- "$entry" > "$cache/$total") || return 1
        jq -e 'type == "object"' "$cache/$total" >/dev/null || {
            echo "Invalid JSON object in archive: $relative" >&2; return 1;
        }
        restore_paths+=("$relative")
        (( total+=1 ))
    done <<< "$listing"
    for relative in "${restore_paths[@]}"; do
        payload=$(<"$cache/$completed") || {
            _vcli_partial_failure restore "$completed" "$total" "$relative"; return 1;
        }
        _put "/$relative" "$payload" || {
            _vcli_partial_failure restore "$completed" "$total" "$relative"; return 1;
        }
        (( completed+=1 ))
    done
    printf "Vault backup restored: %s\n" "$archive"
}

# cat function
function _cat(){
    # Request flags belong to one call, never to a later secret read.
    local -a flags=()
    while :; do
        case "${1:-}" in
            -i|-_disable_-f_-) flags+=("$1"); shift ;;
            *) break ;;
        esac
    done
    local url="${1:-}" arg="${2:-}"
    [[ -n $url ]] || { echo "vcli: missing secret path" >&2; return 1; }
    [[ $url == /* ]] || url="$current_pwd$url"
    debug "cat: url=$url"
    _curl "${flags[@]}" "$url" "$arg"
}


# addsecret function
function _addsecret(){
    local url="$1" additions="$2" snapshot version merged current
    url=$(_vcli_absolute_path "$url") || return 1
    [[ -n $additions ]] || { echo "Missing secret data" >&2; return 1; }
    if vcli_is_kv2_path "$url"; then
        snapshot=$(_curl "$url" "" GET raw) || return 1
        version=$(jq -er '.data.metadata.version | select(type=="number")' <<< "$snapshot") || return 1
        current=$(jq -ce '.data.data | select(type=="object")' <<< "$snapshot") || return 1
    else
        snapshot=$(_cat "$url") || return 1
        current=$(jq -ce '.data | select(type=="object")' <<< "$snapshot") || return 1
        version=""
    fi
    merged=$(jq -cn --argjson cur "$current" --argjson add "$additions" '$cur + $add') || return 1
    _put "$url" "$merged" "$version"
}

# delsecret function
function _delsecret(){
    local url="$1" key="$2" snapshot version current updated
    url=$(_vcli_absolute_path "$url") || return 1
    [[ -n $key ]] || { echo "Missing key" >&2; return 1; }
    if vcli_is_kv2_path "$url"; then
        snapshot=$(_curl "$url" "" GET raw) || return 1
        version=$(jq -er '.data.metadata.version | select(type=="number")' <<< "$snapshot") || return 1
        current=$(jq -ce '.data.data | select(type=="object")' <<< "$snapshot") || return 1
    else
        snapshot=$(_cat "$url") || return 1
        current=$(jq -ce '.data | select(type=="object")' <<< "$snapshot") || return 1
        version=""
    fi
    updated=$(jq -cn --argjson obj "$current" --arg key "$key" '$obj | del(.[$key])') || return 1
    _put "$url" "$updated" "$version"
}

# cp function
function _cp(){
    local source destination response payload
    source=$(_vcli_absolute_path "${1:-}") || {
        echo "vcli: invalid copy source" >&2; return 1;
    }
    destination=$(_vcli_absolute_path "${2:-}") || {
        echo "vcli: invalid copy destination" >&2; return 1;
    }
    # A failed read must never be transformed into a successful jq pipeline.
    response=$(_cat "$source") || {
        echo "vcli: copy source read failed" >&2; return 1;
    }
    payload=$(jq -ce '.data | select(type == "object")' <<< "$response") || {
        echo "vcli: invalid copy source data" >&2; return 1;
    }
    debug "cp: payload redacted"
    if vcli_is_kv2_path "$destination"; then
        _put "$destination" "$payload" 0
    else
        _put "$destination" "$payload"
    fi
}

# mv function
function _mv(){
    local source destination snapshot source_version payload dest_result latest latest_version
    source=$(_vcli_absolute_path "${1:-}") || return 1
    destination=$(_vcli_absolute_path "${2:-}") || return 1
    [[ $source != "$destination" ]] || { echo "Cannot move to same path" >&2; return 1; }

    # KV v1 has no version-specific delete; retain historical behavior.
    if ! vcli_is_kv2_path "$source"; then
        _cp "$source" "$destination" && _rm "$source"
        return $?
    fi

    # Snapshot the exact version to be copied, including nested KV2 mounts.
    snapshot=$(_curl "$source" "" GET raw) || return 1
    source_version=$(jq -er '.data.metadata.version | select(type=="number")' <<< "$snapshot") || return 1
    payload=$(jq -ce '.data.data | select(type=="object")' <<< "$snapshot") || return 1

    # Moving between engines is permitted; KV2 destination uses create-only CAS.
    if vcli_is_kv2_path "$destination"; then
        _put "$destination" "$payload" 0 || return 1
    else
        _put "$destination" "$payload" || return 1
    fi

    # After the copy, re-read the origin to detect an intervening writer.
    latest=$(_curl "$source" "" GET raw) || {
        _vcli_partial_failure mv 1 2 "$source"; return 1;
    }
    latest_version=$(jq -er '.data.metadata.version | select(type=="number")' <<< "$latest") || {
        _vcli_partial_failure mv 1 2 "$source"; return 1;
    }
    if [[ $latest_version != "$source_version" ]]; then
        echo "vcli: source changed during move; destination contains copied version" >&2
        _vcli_partial_failure mv 1 2 "$source"
        return 1
    fi

    # KV2 /delete only marks the given version, NEVER a later current version.
    # This cannot be made atomic with the destination write.
    local mount metadata path_file delete_path
    metadata=$(vcli_kv2_metadata_path "$source") || {
        _vcli_partial_failure mv 1 2 "$source"; return 1;
    }
    delete_path="${metadata/\/metadata\//\/delete\/}"
    path_file=$(mktemp "${VCLI_SESSION_TMP:-$TMP}/.vcli-delete.XXXXXX") || {
        _vcli_partial_failure mv 1 2 "$source"; return 1;
    }
    printf '{"versions":[%s]}\n' "$source_version" > "$path_file"
    local delete_status=0
    _curl "$delete_path" "$path_file" POST || delete_status=$?
    rm -f -- "$path_file"
    if (( delete_status != 0 )); then
        _vcli_partial_failure mv 1 2 "$source"
        return 1
    fi
    # A newer version may have been created immediately before the deletion.
    # Detect it; never claim the whole move was successful in that case.
    local after after_version
    after=$(_curl "$metadata") || {
        _vcli_partial_failure mv 1 2 "$source"; return 1;
    }
    after_version=$(jq -er '.data.current_version | select(type=="number")' <<< "$after") || {
        _vcli_partial_failure mv 1 2 "$source"; return 1;
    }
    if [[ $after_version != "$source_version" ]]; then
        echo "vcli: source advanced during version-specific deletion" >&2
        _vcli_partial_failure mv 1 2 "$source"
        return 1
    fi
    printf "Moved version %s from '%s' to '%s'\n" "$source_version" "$source" "$destination"
}

# rm function
function _rm(){
    local path snapshot version metadata delete_path payload after after_version
    local selected="${1:-}" skip_confirmation=no answer
    if [[ $selected == --purge ]]; then
        shift
        if [[ ${1:-} == --yes ]]; then skip_confirmation=yes; shift; fi
        [[ $# == 1 && -n ${1:-} ]] || { echo "Usage: rm --purge [--yes] path" >&2; return 1; }
        path=$(_vcli_absolute_path "$1") || return 1
        vcli_is_kv2_path "$path" || { echo "vcli: purge requires a KV v2 secret path" >&2; return 1; }
        metadata=$(vcli_kv2_metadata_path "$path") || return 1
        if [[ $skip_confirmation != yes ]]; then
            if [[ ! -t 0 ]]; then
                echo "vcli: permanent deletion requires an interactive confirmation (or explicit --yes)" >&2
                return 1
            fi
            read -r -p "PERMANENTLY erase all versions and metadata at $path? Type PURGE: " answer </dev/tty || return 1
            [[ $answer == PURGE ]] || { echo "vcli: purge cancelled" >&2; return 1; }
        fi
        _curl "$metadata" "" DELETE || return 1
        printf "Permanently removed KV v2 metadata and all versions at %s\n" "$path"
        return 0
    fi
    [[ $# == 1 && -n $selected ]] || { echo "Usage: rm path | rm --purge [--yes] path" >&2; return 1; }
    path=$(_vcli_absolute_path "$selected") || return 1
    if ! vcli_is_kv2_path "$path"; then
        _curl "$path" "" DELETE
        return $?
    fi
    snapshot=$(_curl "$path" "" GET raw) || {
        # KV2 metadata can outlive a deleted data version; say so explicitly.
        metadata=$(vcli_kv2_metadata_path "$path") || return 1
        local meta_json
        if meta_json=$(_curl "$metadata" "" GET); then
            if jq -e '.data as $d | ($d.versions[($d.current_version|tostring)].deletion_time // "") | length > 0' <<< "$meta_json" >/dev/null 2>&1; then
                printf "vcli: %s is already soft-deleted; metadata and versions remain. Use rm --purge to erase irreversibly.\n" "$path" >&2
            fi
        fi
        return 1
    }
    version=$(jq -er '.data.metadata.version | select(type=="number")' <<< "$snapshot") || return 1
    metadata=$(vcli_kv2_metadata_path "$path") || return 1
    delete_path="${metadata/\/metadata\//\/delete\/}"
    payload=$(mktemp "${VCLI_SESSION_TMP:-$TMP}/.vcli-delete.XXXXXX") || return 1
    printf '{"versions":[%s]}\n' "$version" > "$payload"
    local delete_status=0
    _curl "$delete_path" "$payload" POST || delete_status=$?
    rm -f -- "$payload"
    (( delete_status == 0 )) || return 1
    after=$(_curl "$metadata") || return 1
    after_version=$(jq -er '.data.current_version | select(type=="number")' <<< "$after") || return 1
    if [[ $after_version != "$version" ]]; then
        printf "vcli: source advanced during version-specific delete: %s\n" "$path" >&2
        return 1
    fi
    printf "Soft-deleted KV v2 version %s at %s; metadata/history remain (ls still lists it).\n" "$version" "$path"
}

# put function
function _put(){
    local cas="${3:-}" funcname="${FUNCNAME[0]}" url="$1" data="" metadata="" metadata_file=""
    [[ $url == /* ]] || url="$current_pwd$1"
    debug "put: url=$url"
    debug "put: payload redacted"
    data=$(mktemp -- "${VCLI_SESSION_TMP:-$TMP}/.put.XXXXXX") || return 1
    # Abort rather than writing a partial expanded secret.
    if command -v envsubst >/dev/null 2>&1; then
        if ! printf '%s\n' "$2" | envsubst > "$data"; then
            rm -f -- "$data"; return 1
        fi
    elif ! printf '%s\n' "$2" > "$data"; then
        rm -f -- "$data"; return 1
    fi
    if [[ -z $url ]]; then
        echo "Error! Missing secret path" >&2
        commands_help "${funcname//_/}"
        rm -f -- "$data"; return 1
    fi
    url="${url/\/\//\/}"
    debug "put: request prepared"
    debug "put: submitting prepared request"
    if [[ -z $cas ]] && vcli_is_kv2_path "$url"; then
        metadata=$(vcli_kv2_metadata_path "$url") || {
            rm -f -- "$data"; return 1
        }
        metadata_file=$(mktemp "${VCLI_SESSION_TMP:-$TMP}/.vcli.metadata.XXXXXX") || {
            rm -f -- "$data"; return 1
        }
        if _curl "$metadata" > "$metadata_file"; then
            cas=$(jq -er '.data.current_version | select(type=="number")' "$metadata_file") || {
                rm -f -- "$metadata_file" "$data"; return 1
            }
        elif [[ $http_code == 404 ]]; then
            cas=0
        else
            rm -f -- "$metadata_file" "$data"
            echo "vcli: unable to read KV v2 metadata before write" >&2
            return 1
        fi
        rm -f -- "$metadata_file"
    fi
    # _curl may fail before reading the payload; it is still ours to clean.
    local result=0
    _curl "$url" "$data" "POST" "$cas" || result=$?
    rm -f -- "$data"
    return "$result"
}

