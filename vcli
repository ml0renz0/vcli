#!/usr/bin/env bash

# vcli internal variables
declare SCRIPTNAME
SCRIPTNAME="$(basename "$0")"
declare VERSION="0.6.3-revival"
declare VERBOSE=${VERBOSE:-"no"}
declare DEBUG=${DEBUG:-"no"}
declare DEBUG_HEXDUMP="no"
declare DEBUGFILE="${VCLI_DEBUGFILE:-$HOME/.vcli.debug}"
declare VCLI_DEBUG_FD=""
declare TMP="${TMPDIR:-/tmp}"
# Keep user-visible backups and exports under TMP, but stage sensitive
# requests in a distinct 0700 directory removed on exit or TERM/INT.
declare VCLI_SESSION_TMP="" VCLI_SESSION_PID=""
declare VCLI_TTY_STATE=""
umask 077

function vcli_session_cleanup(){
    # Never let an inherited EXIT trap in a subshell remove its parent files.
    [[ $BASHPID == "$VCLI_SESSION_PID" ]] || return 0
    vcli_terminal_restore
    [[ -n $VCLI_SESSION_TMP ]] || return 0
    local owned="$VCLI_SESSION_TMP"
    VCLI_SESSION_TMP=""
    rm -rf -- "$owned"
}

# On macOS Bash's per-read tty mode restoration is unreliable under PTY;
# configure the interactive editor once, then restore the user's exact mode
# on every exit path via the existing session EXIT trap.
function vcli_terminal_open(){
    [[ $OSTYPE == darwin* && -t 0 ]] || return 0
    [[ -z ${VCLI_TTY_STATE:-} ]] || return 0
    local saved
    saved=$(stty -g </dev/stdin) || return 1
    # Disable VEOF as well: Darwin may re-enable canonical input during
    # Bash read -s, consuming Ctrl+D instead of returning its byte.
    if ! stty -icanon -echo eof undef min 1 time 0 </dev/stdin; then
        stty "$saved" </dev/stdin || true
        return 1
    fi
    VCLI_TTY_STATE=$saved
}

function vcli_terminal_restore(){
    [[ -n ${VCLI_TTY_STATE:-} ]] || return 0
    local saved=$VCLI_TTY_STATE
    VCLI_TTY_STATE=""
    stty "$saved" </dev/stdin || true
}

function vcli_session_open(){
    [[ -z $VCLI_SESSION_TMP ]] || return 0
    VCLI_SESSION_TMP=$(mktemp -d -- "${TMP%/}/.vcli-session.XXXXXXXX") || return 1
    VCLI_SESSION_PID=$BASHPID
    trap 'vcli_session_cleanup' EXIT
    trap 'exit 143' TERM
    # The interactive editor installs its own Ctrl+C handler later.
    trap 'exit 130' INT
}

