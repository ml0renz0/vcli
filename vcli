# download keytab to /tmp
function _vcli_krb_pairs(){
    local data="$1" stem principal encoded file listing line found
    local -a stems
    mapfile -t stems < <(jq -r 'keys[] | select(endswith("_principal")) | .[:-10]' <<< "$data")
    (( ${#stems[@]} )) || return 1
    for stem in "${stems[@]}"; do
        [[ $stem =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $stem != *..* ]] || return 1
        principal=$(jq -er --arg k "${stem}_principal" '.[$k] | select(type=="string")' <<< "$data") || return 1
        [[ $principal =~ ^[A-Za-z0-9._/-]+@[A-Za-z0-9._-]+$ && $principal != *..* ]] || return 1
        encoded=$(jq -er --arg k "${stem}_keytab" '.[$k] | select(type=="string")' <<< "$data") || return 1
        file=$(mktemp "${VCLI_SESSION_TMP:-$TMP}/.vcli-krb.XXXXXX") || return 1
        if ! printf '%s' "$encoded" | base64 -d > "$file" 2>/dev/null ||
           ! listing=$(LC_ALL=C klist -k "$file" 2>/dev/null); then
            rm -f "$file"
            echo "vcli: invalid keytab or principal" >&2
            return 1
        fi
        rm -f "$file"
        # Match the complete principal field, not a substring or file/header.
        found=no
        while IFS= read -r line; do
            if [[ $line =~ ^[[:space:]]*[0-9]+[[:space:]]+([^[:space:]]+)[[:space:]]*$ &&
                  ${BASH_REMATCH[1]} == "$principal" ]]; then
                found=yes
                break
            fi
        done <<< "$listing"
        [[ $found == yes ]] || { echo "vcli: invalid keytab or principal" >&2; return 1; }
    done
    (( $(jq '[keys[] | select(endswith("_keytab"))] | length' <<< "$data") == ${#stems[@]} ))
}
function _getkrb() (
    local data stem principal encoded stage="" i=0 destination
    # A dedicated subshell owns the staging directory. EXIT runs on normal
    # failure and on catchable TERM/INT, including errors during decoding.
    trap '[[ -z ${stage:-} ]] || rm -rf -- "$stage"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    data=$(_vcli_pki_json "${1:-}") || return 1
    _vcli_krb_pairs "$data" || return 1
    local -a stems destinations=()
    mapfile -t stems < <(jq -r 'keys[] | select(endswith("_principal")) | .[:-10]' <<< "$data")
    for stem in "${stems[@]}"; do
        principal=$(jq -er --arg k "${stem}_principal" '.[$k]' <<< "$data") || return 1
        destinations+=("$TMP/${principal//\//_}.keytab")
    done
    _vcli_export_preflight "${destinations[@]}" || return 1

    stage=$(mktemp -d -- "${VCLI_SESSION_TMP:-$TMP}/.vcli-export.XXXXXXXX") || return 1
    for stem in "${stems[@]}"; do
        encoded=$(jq -er --arg k "${stem}_keytab" '.[$k]' <<< "$data") || {
            rm -rf -- "$stage"; return 1;
        }
        # Decode into a private staged inode, never into the final pathname.
        if ! (set -o pipefail; printf '%s' "$encoded" |
              base64 -d > "$stage/$i"); then
            rm -rf -- "$stage"
            echo "vcli: keytab staging failed" >&2
            return 1
        fi
        i=$((i+1))
    done
    _vcli_export_publish "$stage" "${destinations[@]}" || return 1
    for destination in "${destinations[@]}"; do
        printf 'Exported %s\n' "$destination"
    done
)
