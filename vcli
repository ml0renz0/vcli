# return whether is a command or not
function is_cmd(){
    local command=${1%% *}
    local args
    [[ -n $command && ${vcli_commands[$command]+present} ]] || return 1
    args=${1#"$command"}
    # Only noarg commands reject additional non-whitespace arguments.
    [[ ${vcli_commands[$command]} != noarg || -z ${args//[[:space:]]/} ]]
}


# complete command
function completion(){
    debug "run completion"
    local -a tmparray
    local found _cmd _path _secret paths
    local -a commands=( ${!vcli_commands[@]} )
    IFS=' ' read -r _cmd _option _path <<< "${@}"
    if [[ ! $_path ]]; then
        _path=$_option
        unset _option
    fi
    debug "completion: command candidate"
    # complete command
    if [[ ! $_path ]]; then
        if ! is_cmd "$_cmd" || [[ ! $_cmd =~ \ $ ]]; then
            for c in "${commands[@]}"; do
                if [[ $c =~ ^$_cmd ]]; then
                    debug "found: $c"
                    tmparray+=( $c )
                fi
            done
            found=${#tmparray[@]}
            debug "commands_found $found: " "${tmparray[@]}"
            local tmpcmd_so_far cmd_so_far
            if [[ $found == 1 ]]; then
                cmd="${tmparray[0]} "
                debug "completion: command prefix"
            elif [[ $found -gt 1 ]]; then
                echo
                for p in "${tmparray[@]}"; do
                    echo "$p"
                done
                local n=1
                local i=0
                # compare all found occurrences and build the common substring
                while true ; do
                    tmpcmd_so_far=${tmparray[$i]::$n}
                    debug "tmpcmd_so_far: $tmpcmd_so_far"
                    while [[ $i -lt ${#tmparray[@]} ]]; do
                        debug "cmdmatch: i=$i n=$n ${tmparray[$i]::$n} == $tmpcmd_so_far"
                        if [[ ${tmparray[$i]::$n} != "$tmpcmd_so_far" ]]; then
                            end="true"
                            break 2
                        fi
                        tmpcmd_so_far=${tmparray[$i]::$n}
                        let i++
                    done
                    if [[ ! $end ]]; then
                        cmd_so_far=$tmpcmd_so_far
                        debug "completion: command prefix"
                    fi
                    let n++
                    let i=0
                done
                cmd="$cmd_so_far"
                debug "completion: command completed"
                unset tmparray tmpcmd_so_far cmd_so_far end
                prompt
                return 1
            fi
        fi
    # complete path or a help subcommand
    else
        if [[ $_cmd == help ]]; then
            local candidate
            for candidate in "${commands[@]}"; do
                [[ $candidate == "$_path"* ]] && tmparray+=( "$candidate" )
            done
            if (( ${#tmparray[@]} == 1 )); then
                cmd="help ${tmparray[0]}"
            elif (( ${#tmparray[@]} > 1 )); then
                printf '\n%s\n' "${tmparray[@]}"
                prompt
                return 1
            fi
            return 0
        fi
        debug "completion: searching path"
        _secret=${_path##*/}
        debug "completion: inspecting path"
        if [[ $_path != "$_secret" ]]; then
            _path=${_path%$_secret*}
        else
            unset _path
        fi
        debug "completion: checking path"
        paths=$(_ls "-_disable_colors_-" "$_path" | tr -t '\n' ' ' | tr -s ' ')
        debug "completion: path list obtained"

        backIFS=$IFS
        IFS=$' '
        for p in $paths; do
            if [[ $p =~ ^$_secret ]]; then
                debug "found path: $p"
                tmparray+=( $p )
            fi
        done
        IFS=$backIFS
        found=${#tmparray[@]}
        debug "paths_found $found: " "${tmparray[@]}"
        debug "completion: resolved candidate"
        local tmpath_so_far path_so_far
        if [[ $found == 1 ]]; then
            cmd="$_cmd ${_option:+$_option }$_path${tmparray[0]}"
            debug "completion: path prefix"
        elif [[ $found -gt 1 ]]; then
            echo
            for p in "${tmparray[@]}"; do
                echo "$p" | sed -e "s/\//$CYAN\/$NONE/"
            done
            local n=1
            local i=0
            # compare all found occurrences and build the common substring
            while true ; do
                tmpath_so_far=${tmparray[$i]::$n}
                debug "tmpath_so_far: $tmpath_so_far"
                while [[ $i -lt ${#tmparray[@]} ]]; do
                    debug "pathmatch: i=$i n=$n ${tmparray[$i]::$n} == $tmpath_so_far"
                    if [[ ${tmparray[$i]::$n} != "$tmpath_so_far" ]]; then
                        end="true"
                        break 2
                    fi
                    tmpath_so_far=${tmparray[$i]::$n}
                    let i++
                done
                if [[ ! $end ]]; then
                    path_so_far=$tmpath_so_far
                    debug "completion: path prefix"
                fi
                let n++
                let i=0
            done
            cmd="$_cmd ${_option:+$_option }$_path$path_so_far"
            debug "completion: path completed"
            unset tmparray tmpath_so_far path_so_far end
            prompt
            return 1
        fi
    fi
    unset tmparray found
}

# Record accepted commands, including failed Vault requests, for reliable recall. Loading files is handled only by load_history.
function add_cmd(){
    local cmd old_cmd
    # Trim with Bash rather than GNU-specific sed BRE escapes; preserve
    # whitespace collapsing and exact history de-duplication on Darwin.
    cmd="$*"
    cmd="${cmd#"${cmd%%[![:space:]]*}"}"
    cmd="${cmd%"${cmd##*[![:space:]]}"}"
    cmd=$(printf '%s' "$cmd" | tr -s ' ')
    is_cmd "$cmd" || return 1
    # Do not persist potentially sensitive command payloads by default.
    if [[ ${VCLI_HISTORY_SECRETS:-false} != true &&
          $cmd =~ ^(put|addsecret|replace|delsecret|find)[[:space:]] ]]; then
        return 0
    fi
    local -a new_history=( "$cmd" )
    for old_cmd in "${cmd_history[@]}"; do
        [[ $old_cmd == "$cmd" ]] || new_history+=( "$old_cmd" )
    done
    cmd_history=( "${new_history[@]}" )
    debug "history: command recorded"
}

# Redraw a command after moving through interactive history.
function vcli_redraw_history(){
    [[ $pos != 1 ]] && vcli_tput cub $((pos-1))
    vcli_tput el
    printf '%s' "$cmd"
    vcli_tput el
    len=${#cmd}
    pos=$((len+1))
}

# UP: browse older commands without adding unfinished input to history.
function get_prev_cmd(){
    if (( history_index == -1 )); then
        history_draft=$cmd
    fi
    if (( history_index + 1 < ${#cmd_history[@]} )); then
        history_index=$((history_index+1))
        cmd=${cmd_history[$history_index]}
        vcli_redraw_history
    fi
}

# DOWN: restore the unsent input after the most recent history entry.
function get_next_cmd(){
    if (( history_index > 0 )); then
        history_index=$((history_index-1))
        cmd=${cmd_history[$history_index]}
        vcli_redraw_history
    elif (( history_index == 0 )); then
        history_index=-1
        cmd=${history_draft:-}
        unset history_draft
        vcli_redraw_history
    fi
}

# returns last command's path
# Bash-like !$ expands to the last whitespace-delimited argument.
function get_lastcmd_arg(){
    local previous="${cmd_history[0]:-}"
    [[ -n $previous && $previous == *" "* ]] || return 1
    printf '%s\n' "${previous##* }"
}

# saves history to $HOME/.vclistory
function save_history(){
    local history_tmp idx
    # Never write through a symlink or truncate an existing unrelated file.
    if [[ -L $VCLISTORY || ( -e $VCLISTORY && ! -f $VCLISTORY ) ]]; then
        printf 'vcli: refusing unsafe history path: %s\n' "$VCLISTORY" >&2
        return 1
    fi
    # A temporary file in the same directory makes replacement atomic and 0600.
    history_tmp=$(mktemp "${VCLISTORY}.XXXXXXXX") || return 1
    chmod 600 "$history_tmp" || { rm -f -- "$history_tmp"; return 1; }
    for (( idx=${#cmd_history[@]}-1 ; idx>=0 ; idx-- )); do
        if ! printf '%s\n' "${cmd_history[idx]}" >> "$history_tmp"; then
            rm -f -- "$history_tmp"
            return 1
        fi
    done
    # Recheck, and use rename rather than opening the target for writing.
    if [[ -L $VCLISTORY || ( -e $VCLISTORY && ! -f $VCLISTORY ) ]]; then
        rm -f -- "$history_tmp"
        printf 'vcli: refusing unsafe history path: %s\n' "$VCLISTORY" >&2
        return 1
    fi
    # Exact-path rename refuses a raced-in directory on both platforms.
    vcli_replace_exact "$history_tmp" "$VCLISTORY" || { rm -f -- "$history_tmp"; return 1; }
}

# loads history from $HOME/.vclistory
function load_history(){
    [[ ! -L $VCLISTORY && -f $VCLISTORY && -r $VCLISTORY ]] || return 0
    local -a loaded=()
    local idx fd path_identity fd_identity
    # Pin the inode before reading; macOS /dev/fd may have a synthetic
    # device number, so compare inode + owner, with -ef additionally on Linux.
    if ! { exec {fd}< "$VCLISTORY"; }; then return 1; fi
    path_identity=$(vcli_stat_identity "$VCLISTORY" 2>/dev/null) || path_identity=""
    fd_identity=$(vcli_stat_identity "/dev/fd/$fd" 2>/dev/null) || fd_identity=""
    if [[ -L $VCLISTORY || ! -f /dev/fd/$fd ||
          -z $fd_identity || $path_identity != "$fd_identity" ]] ||
       { [[ $OSTYPE != darwin* ]] && [[ ! $VCLISTORY -ef /dev/fd/$fd ]]; }; then
        exec {fd}<&-
        echo "vcli: history path changed while opening" >&2
        return 1
    fi
    if ! mapfile -t loaded <&"$fd"; then
        exec {fd}<&-
        return 1
    fi
    exec {fd}<&-
    cmd_history=()
    for (( idx=${#loaded[@]}-1; idx>=0; idx-- )); do
        [[ -n ${loaded[idx]} ]] && cmd_history+=( "${loaded[idx]}" )
    done
}

# loads history from $HOME/.vclistory
function print_history(){
    if [[ ${#cmd_history[@]} == 0 ]]; then
        echo "No history found"
        return
    fi
    local n=1
    local depth
    local historylines=${#cmd_history[@]}
    depth="$(( ${#historylines} - 1 ))"
    for (( idx=${#cmd_history[@]}-1 ; idx>=0 ; idx-- )) ; do
        npadded="$(printf %0"${depth}"d $n)"
        echo "#$npadded: ${cmd_history[$idx]}"
        let n++
    done
}

# return vcli commands found in history matching $cmd
function rotate_found_cmds(){
    debug "rotate_found_cmds"
    if [[ ! $search_cmd ]]; then
        search_cmd="$*"
    fi
    debug "history: reverse search"
    if [[ ! $SEARCHIST ]]; then
        # starting vcli search mode. Build a tmp_history with all matching commands
        for (( idx=0 ; idx<=${#cmd_history[@]}-1 ; idx++ )) ; do
            if [[ "${cmd_history[$idx]}" == *"$search_cmd"* ]]; then
                tmp_history+=( "${cmd_history[$idx]}" )
            fi
            [[ ! $SEARCHIST ]] && SEARCHIST="0"
        done
        if (( ${#tmp_history[@]} == 0 )); then
            unset SEARCHIST search_cmd tmp_history
            return 1
        fi
        # print first command found
        # if another Ctrl+r is hit next item will be printed
        debug "\${#tmp_history}=${#tmp_history[@]}"
        debug "history search entry selected"
        cmd="${tmp_history[$SEARCHIST]}"
    else
        let SEARCHIST++
        if (( ${#tmp_history[@]} == 0 )); then
            unset SEARCHIST search_cmd tmp_history
            return 1
        fi
        SEARCHIST=$((SEARCHIST%(${#tmp_history[@]})))
        debug "\${#tmp_history}=${#tmp_history[@]}"
        debug "history search entry selected"
        cmd="${tmp_history[$SEARCHIST]}"
    fi
}
