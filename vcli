# One read per leaf, preserving strict certificate/key matching.
function _getallcertlist(){
    local root leaves path data
    root=$(_vcli_absolute_path "${1:-}") || return 1
    leaves=$(_vcli_leaves "$root") || return 1
    while IFS= read -r path; do
        [[ -n $path ]] || continue
        data=$(_vcli_pki_json "$path") || return 1
        jq -e 'any(keys[]; endswith("_crt"))' <<< "$data" >/dev/null || continue
        vcli_cert_list_from_data "$path" "$data" || return 1
    done <<< "$leaves"
}


# shows all certificate's expiration dates
# Reuse the validated response rather than re-reading matched certs.
function _getallcertexpiration(){
    local root leaves path data option="" result=0 scanned=0
    if [[ ${1:-} == -o* ]]; then option="$1"; shift; fi
    root=$(_vcli_absolute_path "${1:-}") || return 1
    [[ ${2:-} == -o* ]] && option="$2"
    # The notification runs independently of LIST/GET latency; no added
    # delay on fast operations or alteration of recorded benchmark timing.
    ( sleep 5; printf 'vcli: scanning certificates under %s; large trees may take time...\n' "$root" >&2 ) &
    local notice_pid=$!
    if ! leaves=$(_vcli_leaves "$root"); then
        result=1
    else
        while IFS= read -r path; do
            [[ -n $path ]] || continue
            ((scanned+=1))
            if ! data=$(_vcli_pki_json "$path"); then result=1; break; fi
            jq -e 'any(keys[]; endswith("_crt"))' <<< "$data" >/dev/null || continue
            if ! vcli_cert_expiration_from_data "$path" "$option" "$data"; then
                result=1
                break
            fi
        done <<< "$leaves"
    fi
    # Kill the delayed notification whenever work finishes, including errors.
    kill "$notice_pid" 2>/dev/null || :
    wait "$notice_pid" 2>/dev/null || :
    if (( result != 0 )); then
        printf 'vcli: certificate scan stopped after %d secret(s)\n' "$scanned" >&2
    fi
    return "$result"
}

# download certificates crt and key
function _vcli_pki_json(){
    local response
    response=$(_cat "$1") || return 1
    jq -ce '.data | select(type=="object")' <<< "$response"
}
function _vcli_cert_pairs(){
    local data="$1" stem crt key certpub keypub
    local -a stems
    mapfile -t stems < <(jq -r 'keys[] | select(endswith("_crt")) | .[:-4]' <<< "$data")
    (( ${#stems[@]} > 0 )) || { echo "vcli: no certificates" >&2; return 1; }
    for stem in "${stems[@]}"; do
        [[ $stem =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ && $stem != .* && $stem != *..* ]] || return 1
        crt=$(jq -er --arg k "${stem}_crt" '.[$k] | select(type=="string")' <<< "$data") || return 1
        key=$(jq -er --arg k "${stem}_key" '.[$k] | select(type=="string")' <<< "$data") || return 1
        certpub=$(printf '%s\n' "$crt" | openssl x509 -pubkey -noout 2>/dev/null) || return 1
        keypub=$(printf '%s\n' "$key" | openssl pkey -pubout 2>/dev/null) || return 1
        [[ $certpub == "$keypub" ]] || { echo "vcli: certificate/private key mismatch" >&2; return 1; }
    done
    (( $(jq '[keys[] | select(endswith("_key"))] | length' <<< "$data") == ${#stems[@]} )) || return 1
}
function _vcli_export_preflight(){
    local path
    for path in "$@"; do
        [[ ! -e $path && ! -L $path ]] || {
            echo "vcli: export destination already exists" >&2; return 1;
        }
    done
}

# Stage all secret bytes privately before publishing them. Hard links create
# each destination exclusively (never truncate, replace, or follow symlinks).
# Exact-path hard links reject raced-in directories on GNU/Linux and macOS.
# Multi-file exports are not transactions, but partial publishes are rolled back.
function _vcli_export_publish() (
    local stage="$1"; shift
    local -a destinations=("$@") linked=()
    local i committed=no
    trap 'if [[ $committed != yes ]]; then
              for i in "${linked[@]}"; do
                  if [[ ${destinations[i]} -ef "$stage/$i" ]]; then
                      rm -f -- "${destinations[i]}"
                  fi
              done
          fi
          rm -rf -- "$stage"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # Probe exact-target semantics, including a directory destination; never
    # trust a vendor ln wrapper silently ignoring -T.
    local probe_link="$stage/.vcli-ln-probe" probe_dir="$stage/.vcli-ln-dir"
    if ! vcli_link_exclusive "$stage/0" "$probe_link" 2>/dev/null ||
       [[ ! "$probe_link" -ef "$stage/0" ]]; then
        echo "vcli: secure export requires exclusive exact-path hard links" >&2
        return 1
    fi
    rm -f -- "$probe_link"
    mkdir -- "$probe_dir" || return 1
    if vcli_link_exclusive "$stage/0" "$probe_dir" 2>/dev/null ||
       [[ -e $probe_dir/0 || -L $probe_dir/0 ]]; then
        echo "vcli: unsafe file publication (directory target accepted)" >&2
        return 1
    fi
    rmdir -- "$probe_dir" || return 1

    for (( i=0; i<${#destinations[@]}; i++ )); do
        if ! vcli_link_exclusive "$stage/$i" "${destinations[i]}"; then
            printf 'vcli: export destination occupied or publication failed: %s\n' \
                "${destinations[i]}" >&2
            return 1
        fi
        linked+=("$i")
    done
    committed=yes
)

function _getcert() (
    local data stem crt key stage="" i=0 destination
    # A dedicated subshell owns the staging directory. EXIT runs on normal
    # failure and on catchable TERM/INT, including errors during decoding.
    trap '[[ -z ${stage:-} ]] || rm -rf -- "$stage"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    data=$(_vcli_pki_json "${1:-}") || return 1
    _vcli_cert_pairs "$data" || return 1
    local -a stems destinations=()
    mapfile -t stems < <(jq -r 'keys[] | select(endswith("_crt")) | .[:-4]' <<< "$data")
    for stem in "${stems[@]}"; do destinations+=("$TMP/$stem.crt" "$TMP/$stem.key"); done
    _vcli_export_preflight "${destinations[@]}" || return 1

    stage=$(mktemp -d -- "${VCLI_SESSION_TMP:-$TMP}/.vcli-export.XXXXXXXX") || return 1
    for stem in "${stems[@]}"; do
        crt=$(jq -er --arg k "${stem}_crt" '.[$k]' <<< "$data") || {
            rm -rf -- "$stage"; return 1;
        }
        key=$(jq -er --arg k "${stem}_key" '.[$k]' <<< "$data") || {
            rm -rf -- "$stage"; return 1;
        }
        if ! printf '%s\n' "$crt" > "$stage/$i"; then
            rm -rf -- "$stage"; return 1
        fi
        i=$((i+1))
        if ! printf '%s\n' "$key" > "$stage/$i"; then
            rm -rf -- "$stage"; return 1
        fi
        i=$((i+1))
    done
    _vcli_export_publish "$stage" "${destinations[@]}" || return 1
    for destination in "${destinations[@]}"; do
        printf 'Exported %s\n' "$destination"
    done
)
# main function
# Forward delete is only generated by CSI 3~, never by a literal tilde.
function vcli_delete_forward(){
    if [[ $len != 0 ]] && [[ $pos -lt $((len+1)) ]]; then
        vcli_tput ech 1
        len=$((len-1))
        cmd="${cmd:0:$((pos-1))}${cmd:${pos}}"
        vcli_tput el
        restcmd="${cmd:$((pos-1))}"
        printf '%s' "$restcmd"
        [[ -n $restcmd ]] && vcli_tput cub "${#restcmd}"
        debug "delete: pos=$pos, len=$len"
    fi
}

# Read one bounded ANSI CSI sequence through its final byte (0x40-0x7E).
# Unknown sequences must be consumed without reaching the line editor.
function vcli_read_csi(){
    local byte count
    csi_sequence=""
    for (( count=0; count<16; count++ )); do
        if ! IFS= read -rsn1 -t 0.2 byte; then
            csi_sequence=""
            return 1
        fi
        csi_sequence+="$byte"
        if [[ $byte == [@-~] ]]; then
            return 0
        fi
        case $byte in
            [0-9]|';'|':'|'?'|' ') ;;
            *) csi_sequence=""; return 1 ;;
        esac
    done
    csi_sequence=""
    return 1
}

# Handle navigation keys common to ANSI CSI and SS3 (application mode).
# Unsupported function keys and modifiers must never enter the command buffer.
function vcli_apply_navigation(){
    case $1 in
        A) get_prev_cmd ;;
        B) get_next_cmd ;;
        1\;5C|5C) vcli_move_word_right ;;
        1\;5D|5D) vcli_move_word_left ;;
        C) # Right
            if (( pos < len+1 )); then
                vcli_tput cuf 1
                pos=$((pos+1))
            fi
        ;;
        D) # Left
            if (( pos > 1 )); then
                vcli_tput cub 1
                pos=$((pos-1))
            fi
        ;;
        F|4~|8~) # End (including xterm numeric variants)
            (( len == 0 )) || vcli_tput cuf $((len-pos+1))
            pos=$((len+1))
        ;;
        H|1~|7~) # Home (including xterm numeric variants)
            (( pos == 1 )) || vcli_tput cub $((pos-1))
            pos=1
        ;;
        3~) vcli_delete_forward ;;
    esac
}

function vcli_word_left_offset(){
    local i=$((pos-1))
    while ((i>0)) && [[ ${cmd:i-1:1} == [[:space:]] ]]; do ((i--)); done
    while ((i>0)) && [[ ${cmd:i-1:1} != [[:space:]] ]]; do ((i--)); done
    VCLI_WORD_OFFSET=$i
}
function vcli_word_right_offset(){
    local i=$((pos-1))
    while ((i<len)) && [[ ${cmd:i:1} != [[:space:]] ]]; do ((i++)); done
    while ((i<len)) && [[ ${cmd:i:1} == [[:space:]] ]]; do ((i++)); done
    VCLI_WORD_OFFSET=$i
}
function vcli_move_word_left(){
    vcli_word_left_offset
    local diff=$((pos-1-VCLI_WORD_OFFSET))
    ((diff>0)) && vcli_tput cub "$diff"
    pos=$((VCLI_WORD_OFFSET+1))
}
function vcli_move_word_right(){
    vcli_word_right_offset
    local diff=$((VCLI_WORD_OFFSET-pos+1))
    ((diff>0)) && vcli_tput cuf "$diff"
    pos=$((VCLI_WORD_OFFSET+1))
}
function vcli_delete_previous_word(){
    vcli_word_left_offset
    local start=$VCLI_WORD_OFFSET old=$((pos-1))
    ((old>start)) || return 0
    cmd="${cmd:0:start}${cmd:old}"
    ((old>0)) && vcli_tput cub "$old"
    printf '%s' "$cmd"
    vcli_tput el
    len=${#cmd}
    ((len>start)) && vcli_tput cub "$((len-start))"
    pos=$((start+1))
}

# Ctrl+C and Ctrl+U must discard the entire edit/navigation/search state.
function vcli_clear_editor(){
    cmd=""
    len=0
    pos=1
    history_index=-1
    unset history_draft SEARCHIST search_cmd tmp_history pending_key ENDHIST
}

# Keep consuming the paste after an interrupt until its closing marker.
# Otherwise a pasted newline after Ctrl+C could execute a Vault command.
function vcli_interrupt_editor(){
    VCLI_EDITOR_INTERRUPTED=yes
    vcli_clear_editor
    if [[ $vcli_paste_mode == yes ]]; then
        vcli_paste_bad=yes
    else
        vcli_paste_mode=""
        vcli_paste_bad=""
    fi
    printf '\n'
    prompt
}

# macOS tty echo is already disabled once by vcli_terminal_open.
# Avoid Bash read -s reconfiguring/restoring the PTY on every keystroke.
function vcli_read_editor_key(){
    # Darwin read -s can race with SIGINT while resetting termios, losing
    # Ctrl+C and leaving stale editor input. The PTY is set up once by
    # vcli_terminal_open; do not request Bash's per-keystroke tty changes.
    if [[ $OSTYPE == darwin* ]]; then
        IFS= read -r -N1 _key
    else
        IFS= read -r -sN1 _key
    fi
}

function main(){
    # Track bracketed paste explicitly so an embedded newline cannot execute
    # a Vault command before the user confirms the pasted input.
    local vcli_paste_mode="" vcli_paste_bad=""
    # First of all: check command dependencies
    check_dependency "$DEPENDENCIES"
    local msg info

    # Return vcli version and quit
    if [[ "$*" == "--version" ]]; then
        msg="vcli v$VERSION"
        if info=$(new_version 2>&1); then
            msg+=" (update available)\n$info"
        fi
        echo -e "$msg"
        exit
    fi

    local tmpmsg
    protocol="https"
    while getopts "v:p:t:hin" opt; do
        case $opt in
            v) vault_host=$OPTARG ;;       ### GLOBAL VARIABLES ###
            p) vault_port=$OPTARG ;;       ### GLOBAL VARIABLES ###
            t) vault_token=$OPTARG ;;      ### GLOBAL VARIABLES ###
            n) disable_prompt=yes ;;
            i) protocol="http";;
            h) help; exit 0 ;;
            *) help; exit 2 ;;
        esac
    done

    # check for new versions
    if new_version && [[ ! $disable_prompt ]]; then sleep 2 ; echo; fi

    # VAULT_ADDR overrides VAULT_HOST / VAULT_PORT when configured.
    if [[ -n ${VAULT_ADDR:-} ]]; then
        local address="${VAULT_ADDR%/}"
        if [[ $address =~ ^(https?)://(\[[^]]+\]|[^:/]+)(:([0-9]+))?$ ]]; then
            protocol="${BASH_REMATCH[1]}"
            vault_host="${BASH_REMATCH[2]}"
            vault_port="${BASH_REMATCH[4]:-8200}"
        else
            echo "Invalid VAULT_ADDR: $VAULT_ADDR" >&2
            exit 1
        fi
    fi
    vault_port="${vault_port:-${VAULT_PORT:-8200}}"
    vault_host="${vault_host:-${VAULT_HOST:-}}"
    vault_token="${vault_token:-${VAULT_TOKEN:-}}"

    # Check for correct arguments
    check_arg "$vault_host" "Vault host"
    vcli_session_open || exit 1
    if [[ -z $vault_token ]]; then
        _vcli_login_approle || exit 1
    fi
    check_arg "$vault_token" "Vault token"

    # Check connectivity
    check_connectivity || exit 1

    # BEGIN
    # initialize variables
    len=0
    pos=1
    history_index=-1

    # Never write or delete a secret merely to start vcli.
    # Vault permissions are checked when individual commands are executed.

    # load vcli history
    load_history

    # Show vault's health
    [[ ! $disable_prompt ]] && _cat "-_disable_-f_-" sys/health

    # Configure macOS input BEFORE displaying the prompt: a PTY client can
    # start sending Ctrl+D/CSI immediately on seeing the prompt.
    if [[ ${disable_prompt:-} != yes ]] && ! vcli_terminal_open; then
        echo "vcli: unable to configure interactive terminal" >&2
        exit 1
    fi

    # print prompt
    prompt

    # Batch mode is line-oriented: do not use the interactive one-byte reader.
    # Propagate failed CLI command status even when no HTTP request was sent.
    if [[ ${disable_prompt:-} == yes ]]; then
        local batch_line batch_result=0
        while IFS= read -r batch_line || [[ -n $batch_line ]]; do
            [[ -z ${batch_line//[[:space:]]/} ]] && continue
            if ! run_cmd "$batch_line"; then batch_result=1; fi
        done
        save_history
        exit "$batch_result"
    fi

    # Ctrl+C clears the editing buffer without terminating the session.
    trap 'vcli_interrupt_editor' INT

    # Begin iteration
    IFS=
    while true; do
        lastkey=$_key
        # read key and process
        if [[ ${pending_key+x} ]]; then
            _key=$pending_key
            unset pending_key
        elif ! vcli_read_editor_key; then
            # A real terminal can still return EOF (notably Ctrl+D on Darwin).
            # Only SIGINT is a recoverable interrupted read; a TTY alone is
            # not evidence that the read should be retried indefinitely.
            if [[ ${VCLI_EDITOR_INTERRUPTED:-} == yes ]]; then
                VCLI_EDITOR_INTERRUPTED=""
                continue
            fi
            clean_n_exit
        fi
        VCLI_EDITOR_INTERRUPTED=""
        # Bracketed paste must never execute embedded newlines or control keys.
        # Once unsafe input is seen, drop the rest until the closing CSI 201~.
        if [[ $vcli_paste_mode == yes && $_key != $'\x1b' ]]; then
            if [[ $_key == [[:cntrl:]] ]]; then
                if [[ $vcli_paste_bad != yes ]]; then
                    vcli_paste_bad=yes
                    vcli_clear_editor
                    printf '\r'
                    prompt
                    vcli_tput el
                fi
                continue
            fi
            [[ $vcli_paste_bad == yes ]] && continue
        fi
        case $_key in
            $'\x1b') # Escape, optionally followed by an ANSI CSI sequence
                if IFS= read -rsn1 -t 0.2 _key; then
                    if [[ $_key == "[" ]]; then
                        if vcli_read_csi; then
                            case $csi_sequence in
                                200~) vcli_paste_mode=yes ;;
                                201~)
                                    if [[ $vcli_paste_bad == yes ]]; then
                                        printf '\nvcli: bracketed paste discarded (control/newline data)\n'
                                        prompt
                                    fi
                                    vcli_paste_mode=""
                                    vcli_paste_bad=""
                                ;;
                                *) [[ $vcli_paste_mode == yes ]] ||
                                       vcli_apply_navigation "$csi_sequence" ;;
                            esac
                        fi
                    elif [[ $_key == "O" ]]; then # SS3 (application cursor mode)
                        # Some terminals use ESC O H/F/A/B/C/D rather than CSI.
                        # Consume unsupported SS3 keys (e.g. F1=ESC O P) whole.
                        if IFS= read -rsn1 -t 0.2 _ss3_key; then
                            [[ $vcli_paste_mode == yes ]] ||
                                vcli_apply_navigation "$_ss3_key"
                        fi
                    elif [[ $_key == "b" ]]; then # Alt+Left
                        [[ $vcli_paste_mode == yes ]] || vcli_move_word_left
                    elif [[ $_key == "f" ]]; then # Alt+Right
                        [[ $vcli_paste_mode == yes ]] || vcli_move_word_right
                    elif [[ $_key == $'\x7f' ]]; then # Alt+Backspace
                        [[ $vcli_paste_mode == yes ]] || vcli_delete_previous_word
                    else
                        # Preserve the ordinary/control key after a lone ESC.
                        pending_key=$_key
                    fi
                fi
                unset ENDHIST
            ;;
            $'\x0a') # ENTER
                unset ENDHIST
                is_command="true"
                debug "current_pwd=$current_pwd"
                [[ ! $disable_prompt ]] && echo
                if [[ $cmd ]] && [[ ! "$cmd" =~ ^[[:space:]]+$ ]]; then
                    cmd=$(echo "$cmd" | sed -e "s/^[[:space:]]\+\(.*\)/\1/g" -e "s/[[:space:]]\+$//g" | tr -s ' ')
                    if ! run_cmd "$cmd"; then exit_status=1; fi
                fi
            ;;
            $'\x7f') # BACKSPACE
                unset ENDHIST
                if [[ $len != 0 ]] && [[ $pos -gt 1 ]]; then # if anything was typed and position>0 allow to delete
                    echo -en "\b \b"
                    let len-=1
                    let pos-=1
                    tmpmsg="${#cmd}: \"$cmd\""
                    # remove $_key in $((pos-1))
                    cmd="${cmd:0:$((pos-1))}${cmd:$((pos)):${#cmd}}"
                    vcli_tput el # clean to the end of the line
                    restcmd="${cmd:$((pos-1)):${#cmd}}"
                    echo -n "$restcmd"
                    # reposition cursor after backspace only if we moved chars
                    if [[ ${#restcmd} != 0 ]]; then vcli_tput cub ${#restcmd} ; fi
                    debug "editor: backspace"
                    debug "pos: $pos, len: $len"
                fi
            ;;
            $'\x09') # tab completions
                completion "$cmd"
                exit_status=$?

                if [[ $exit_status == 0 ]]; then
                    # move the cursor to the beginning to print the command selected
                    [[ $pos != 1 ]] && vcli_tput cub $((pos-1)) # move cursor left to the beginning

                    # print the command found in history
                    len=0
                    pos=1
                    vcli_tput el # clean to the end of the line
                    echo -n "$cmd"
                    vcli_tput el # clean to the end of the line
                    let len=${#cmd}
                    let pos=len+1
                else
                    # print the command found in history
                    len=0
                    pos=1
                    vcli_tput el # clean to the end of the line
                    echo -n "$cmd"
                    vcli_tput el # clean to the end of the line
                    let len=${#cmd}
                    let pos=len+1
                fi
            ;;
            $'\x12') # Ctrl+r
                if [[ ! $cmd ]]; then
                    # clean line
                    echo -e "\nvcli hint: hit Ctrl+r when typing command to search the vcli history"
                    print_history
                    is_command="true"
                else
                    rotate_found_cmds "$cmd"
                    debug "history: reverse search state"


                    # move the cursor to the beginning to print the command selected
                    [[ $pos != 1 ]] && vcli_tput cub $((pos-1)) # move cursor left to the beginning

                    # print the command found in history
                    echo -n "$cmd"

                    vcli_tput el # clean to the end of the line
                    let pos=$((${#cmd}+1))
                    let len=${#cmd}
                fi
            ;;
            
            $'\x17') # Ctrl+W or Ctrl+Backspace
                vcli_delete_previous_word
            ;;
            $'\x15') # Ctrl+U
                vcli_clear_editor
                printf '\r'
                prompt
                vcli_tput el
            ;;
            
            $'\x04') # Ctrl+D
                if [[ -n $cmd ]]; then
                    vcli_delete_forward
                else
                    clean_n_exit
                fi
            ;;
            $'')
                clean_n_exit
            ;;
            $'\x20'|*) # NORMAL CHARS
                if [[ ! $disable_prompt ]]; then
                    vcli_tput ich 1 # insert chars rather than overwriting them
                    echo -n "$_key" #| hexdump -C
                fi
                let len+=1
                let pos+=1
                tmpmsg="${#cmd}: \"$cmd\""
                # insert $_key in $pos within $cmd string
                cmd="${cmd:0:$((pos-2))}$_key${cmd:$((pos-2)):${#cmd}}"
                debug "editor: inserted character"
                debug "pos: $pos, len: $len"
            ;;
        esac
        # Exit history search mode
        if [[ "$_key" != "$lastkey" ]] && [[ "$_key" != $'\x12' ]]; then
            debug "exiting history search mode"
            unset SEARCHIST search_cmd tmp_history
        fi
        [[ $DEBUG_HEXDUMP == "yes" ]] && debug "hexdump: key event redacted"
        # print prompt if commadn was run
        if [[ $is_command ]]; then prompt ; unset is_command cmd pos len history_draft ; history_index=-1 ; pos=1; fi
    # Use the original inherited PTY fd, not a reopened /dev/stdin.
    # Darwin treats reopens of /dev/fd/0 differently for control bytes/EOF.
    done
}

main "$@"
